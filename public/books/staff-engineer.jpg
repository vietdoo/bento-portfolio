<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450" width="300" height="450">
  <defs>
    <linearGradient id="bg-staff-engineer" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b0764" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="spine-staff-engineer" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3"/>
      <stop offset="40%" stop-color="#ffffff" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.4"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="300" height="450" rx="8" fill="url(#bg-staff-engineer)" />

  <!-- Classic Double Gold Frame -->
  <rect x="14" y="14" width="272" height="422" rx="6" fill="none" stroke="#c084fc" stroke-opacity="0.5" stroke-width="1.5" />
  <rect x="18" y="18" width="264" height="414" rx="4" fill="none" stroke="#c084fc" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="4,2" />

  <!-- Top Category Ribbon -->
  <rect x="35" y="32" width="230" height="22" rx="3" fill="#1e1b4b" stroke="#c084fc" stroke-opacity="0.6" stroke-width="1" />
  <text x="150" y="47" font-family="Georgia, 'Times New Roman', serif" font-size="9" font-weight="700" fill="#c084fc" text-anchor="middle" letter-spacing="1.5">CAREER & LEADERSHIP</text>

  <!-- Central Emblem Ornament -->
  <circle cx="150" cy="140" r="42" fill="#1e1b4b" stroke="#c084fc" stroke-width="1.5" stroke-opacity="0.6" />
  <circle cx="150" cy="140" r="37" fill="none" stroke="#c084fc" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="3,2" />
  <g transform="translate(133, 123) scale(1.4)">
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="#c084fc" stroke-width="2" fill="none"/>
  </g>

  <!-- Divider Ribbon -->
  <line x1="40" y1="210" x2="260" y2="210" stroke="#c084fc" stroke-width="1.5" stroke-opacity="0.6" />
  <polygon points="150,205 154,210 150,215 146,210" fill="#c084fc" />

  <!-- Title Text -->
  <text x="150" y="248" font-family="Georgia, 'Times New Roman', serif" font-size="19" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="-0.3">Staff Engineer</text>
  <text x="150" y="276" font-family="Georgia, 'Times New Roman', serif" font-size="17" font-weight="700" fill="#fef3c7" text-anchor="middle" letter-spacing="-0.2">Technical Leadership</text>

  <!-- Author Banner -->
  <line x1="70" y1="330" x2="230" y2="330" stroke="#c084fc" stroke-width="1" stroke-opacity="0.3" />
  <text x="150" y="365" font-family="Georgia, 'Times New Roman', serif" font-size="14" font-weight="600" fill="#c084fc" text-anchor="middle">Will Larson</text>
  <text x="150" y="388" font-family="'Satoshi', sans-serif" font-size="9" font-weight="500" fill="#94a3b8" text-anchor="middle" letter-spacing="2">CLASSIC EDITION</text>

  <!-- Book Spine 3D Shadow -->
  <rect x="0" y="0" width="16" height="450" fill="url(#spine-staff-engineer)" />
  <line x1="16" y1="0" x2="16" y2="450" stroke="#000000" stroke-opacity="0.3" stroke-width="1" />

  <!-- Outer Border -->
  <rect x="0.5" y="0.5" width="299" height="449" rx="7.5" fill="none" stroke="#a855f7" stroke-opacity="0.4" />
</svg>