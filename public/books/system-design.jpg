<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450" width="300" height="450">
  <defs>
    <linearGradient id="bg-system-design" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="spine-system-design" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3"/>
      <stop offset="40%" stop-color="#ffffff" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.4"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="300" height="450" rx="8" fill="url(#bg-system-design)" />

  <!-- Classic Double Gold Frame -->
  <rect x="14" y="14" width="272" height="422" rx="6" fill="none" stroke="#60a5fa" stroke-opacity="0.5" stroke-width="1.5" />
  <rect x="18" y="18" width="264" height="414" rx="4" fill="none" stroke="#60a5fa" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="4,2" />

  <!-- Top Category Ribbon -->
  <rect x="35" y="32" width="230" height="22" rx="3" fill="#0f172a" stroke="#60a5fa" stroke-opacity="0.6" stroke-width="1" />
  <text x="150" y="47" font-family="Georgia, 'Times New Roman', serif" font-size="9" font-weight="700" fill="#60a5fa" text-anchor="middle" letter-spacing="1.5">DISTRIBUTED SYSTEMS</text>

  <!-- Central Emblem Ornament -->
  <circle cx="150" cy="140" r="42" fill="#0f172a" stroke="#60a5fa" stroke-width="1.5" stroke-opacity="0.6" />
  <circle cx="150" cy="140" r="37" fill="none" stroke="#60a5fa" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="3,2" />
  <g transform="translate(133, 123) scale(1.4)">
    <rect x="3" y="3" width="7" height="7" rx="1" stroke="#60a5fa" stroke-width="2" fill="none"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="#60a5fa" stroke-width="2" fill="none"/><rect x="8" y="14" width="8" height="7" rx="1" stroke="#60a5fa" stroke-width="2" fill="none"/>
  </g>

  <!-- Divider Ribbon -->
  <line x1="40" y1="210" x2="260" y2="210" stroke="#60a5fa" stroke-width="1.5" stroke-opacity="0.6" />
  <polygon points="150,205 154,210 150,215 146,210" fill="#60a5fa" />

  <!-- Title Text -->
  <text x="150" y="248" font-family="Georgia, 'Times New Roman', serif" font-size="19" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="-0.3">System Design</text>
  <text x="150" y="276" font-family="Georgia, 'Times New Roman', serif" font-size="17" font-weight="700" fill="#fef3c7" text-anchor="middle" letter-spacing="-0.2">Interview (Vol 1 & 2)</text>

  <!-- Author Banner -->
  <line x1="70" y1="330" x2="230" y2="330" stroke="#60a5fa" stroke-width="1" stroke-opacity="0.3" />
  <text x="150" y="365" font-family="Georgia, 'Times New Roman', serif" font-size="14" font-weight="600" fill="#60a5fa" text-anchor="middle">Alex Xu</text>
  <text x="150" y="388" font-family="'Satoshi', sans-serif" font-size="9" font-weight="500" fill="#94a3b8" text-anchor="middle" letter-spacing="2">CLASSIC EDITION</text>

  <!-- Book Spine 3D Shadow -->
  <rect x="0" y="0" width="16" height="450" fill="url(#spine-system-design)" />
  <line x1="16" y1="0" x2="16" y2="450" stroke="#000000" stroke-opacity="0.3" stroke-width="1" />

  <!-- Outer Border -->
  <rect x="0.5" y="0.5" width="299" height="449" rx="7.5" fill="none" stroke="#3b82f6" stroke-opacity="0.4" />
</svg>