---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import BackLink from "../components/BackLink.astro";
import { illustrationsAll } from "../lib/illustrations";
import { SITE } from "../site-config";
---

<LoaderAnimation />

<script>
  function initLightbox() {
    const overlay = document.getElementById("lightbox-overlay") as HTMLElement;
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const lightboxAlt = document.getElementById("lightbox-alt") as HTMLElement;

    function open(src: string, alt: string) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightboxAlt.textContent = alt;
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100");
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLElement>(".masonry-item").forEach((item) => {
      item.style.cursor = "zoom-in";
      item.addEventListener("click", () => {
        const img = item.querySelector("img");
        if (img) open(img.src, img.alt);
      });
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    document.getElementById("lightbox-close")?.addEventListener("click", close);
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>

<Layout
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Engineering Showcase`}
  description={`Engineering diagrams, system architecture explorations, visual concepts, and technical illustrations by ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  hideSoundToggle={true}
>
  <div
    id="lightbox-overlay"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/90 opacity-0 pointer-events-none transition-opacity duration-300 p-4"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-white/60 hover:text-white transition-colors text-sm border border-white/20 hover:border-white/50 rounded-lg px-3 py-1.5"
    >
      esc
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-xl object-contain shadow-2xl"
    />
    <p id="lightbox-alt" class="mt-4 text-white/40 text-xs"></p>
  </div>

  <main class="w-full max-w-5xl mx-auto px-6 py-10 text-white">
    <h1 class="text-4xl font-bold mb-2">Engineering Showcase</h1>
    <p class="text-darkslate-300 text-sm mb-10">
      System architecture blueprints, engineering diagrams, visual concepts, and technical illustrations.
    </p>

    <!-- System Architecture Breakdown -->
    <section class="mb-14 space-y-6">
      <h2 class="text-xl font-bold text-primary-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        System Architecture Blueprints
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Big Data ETL -->
        <div class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-primary-500/50 transition-all rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-blue-950/80 border border-blue-600/40 text-blue-400 mb-3">
              Data Pipeline
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition-colors">HCMC 200k+ Property ETL & Analytics</h3>
            <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
              Automated data ingestion from real estate platforms into HDFS storage, distributed transformation using Apache Spark, warehouse loading to Amazon Redshift, and BI dashboarding with Apache Superset.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">HDFS</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Spark</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Redshift</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Superset</span>
          </div>
        </div>

        <!-- Card 2: AI Agent Handover -->
        <div class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-primary-500/50 transition-all rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-purple-950/80 border border-purple-600/40 text-purple-400 mb-3">
              AI Orchestration
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition-colors">AI Agent Handover Architecture</h3>
            <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
              Repo-level state management pattern preventing context loss across LLM agent switches. Uses structured handover ledgers, routing maps, and forcing functions for seamless agentic workflows.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Agentic AI</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">State Ledger</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Claude</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Codex</span>
          </div>
        </div>

        <!-- Card 3: Realtime Binance Streaming -->
        <div class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-primary-500/50 transition-all rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-emerald-950/80 border border-emerald-600/40 text-emerald-400 mb-3">
              Real-time Stream Processing
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition-colors">Binance Real-Time Crypto Streaming</h3>
            <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
              High-throughput streaming pipeline ingesting live crypto ticker data via Binance WebSockets into Apache Kafka, processed with Spark Streaming for rolling 1-hour window statistics.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Kafka</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Spark Streaming</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">WebSockets</span>
          </div>
        </div>

        <!-- Card 4: VNDO Multi-Region Edge & SaaS Ecosystem -->
        <div class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-primary-500/50 transition-all rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-amber-950/80 border border-amber-600/40 text-amber-400 mb-3">
              Global SaaS Infrastructure
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition-colors">VNDO SaaS Ecosystem & Multi-Region Edge</h3>
            <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
              High-performance web creation engine operating across 5 global points of presence (Hanoi, HCMC, Da Nang, Singapore, US). Powers Hồ Sơ Dịch Vụ Công, Văn Bản HCC, Kiosk CHCC, and Điểm Trend.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Multi-Region Edge</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Next.js</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">PostgreSQL</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">&lt;50ms Latency</span>
          </div>
        </div>

        <!-- Card 5: Embery Digital ETL & Vision Pipeline -->
        <div class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-primary-500/50 transition-all rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-cyan-950/80 border border-cyan-600/40 text-cyan-400 mb-3">
              Automated ETL & Vision Analytics
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-primary-400 transition-colors">Embery Multi-Source ETL & Computer Vision</h3>
            <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
              Automated data ingestion workflow consolidating heterogeneous client sources, coupled with integrated Computer Vision models for automated image scoring and trend analytics APIs.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Python</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">ETL Pipelines</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">Computer Vision</span>
            <span class="px-2 py-0.5 rounded bg-darkslate-700/60">OpenCV</span>
          </div>
        </div>
      </div>
    </section>

    <h2 class="text-xl font-bold text-primary-400 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Graphic & Visual Gallery
    </h2>

    <div class="masonry">
      {
        illustrationsAll.map(({ src, alt }) => (
          <div class="masonry-item">
            {typeof src === "string" ? (
              <img
                src={src}
                alt={alt}
                class="w-full h-auto rounded-xl object-cover"
                loading="eager"
                decoding="auto"
              />
            ) : (
              <Image
                src={src}
                alt={alt}
                class="w-full h-auto rounded-xl object-cover"
                loading="eager"
                decoding="auto"
              />
            )}
          </div>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry {
      columns: 3;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 0.75rem;
    position: relative;
  }

  .masonry-item img {
    display: block;
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.1);
  }
</style>
