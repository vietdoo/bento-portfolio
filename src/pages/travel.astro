---
import Globe from "../components/Globe";
import BackLink from "../components/BackLink.astro";
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";
---

<script>
  import { animate, type AnimationSequence } from "motion";

  const sequence = [
    [
      ".loaderRef",
      { opacity: [1, 0], pointerEvents: "none" },
      { type: "spring", ease: "easeOut" },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<BasicLayout
  description={`Interactive 3D globe showing countries visited by ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  page="travel"
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Visited Countries`}
>
  <Globe client:load enableHover={true} />
</BasicLayout>
