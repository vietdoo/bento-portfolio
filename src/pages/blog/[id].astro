---
import { getCollection, render } from "astro:content";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";
import {
  getBlogPostHref,
  getBlogPostPaths,
  getCanonicalBlogId,
  getLocalizedPost,
} from "../../lib/blog-lang";
import { SITE } from "../../site-config";

export const prerender = true;

export async function getStaticPaths() {
  return getBlogPostPaths(await getCollection("blog"));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("id is missing");
}

const posts = await getCollection("blog");
const englishEntry = getLocalizedPost(posts, id, "en");

if (!englishEntry) {
  return Astro.redirect("/404");
}

const vietnameseVersion = getLocalizedPost(posts, id, "vi");
const hasVietnameseTranslation = vietnameseVersion?.data.lang === "vi";

const { Content: EnglishContent, remarkPluginFrontmatter: englishFrontmatter } =
  await render(englishEntry);
const {
  Content: VietnameseContent,
  remarkPluginFrontmatter: vietnameseFrontmatter,
} = hasVietnameseTranslation
  ? await render(vietnameseVersion)
  : { Content: undefined, remarkPluginFrontmatter: undefined };
---

<LayoutBlogPost
  description={englishEntry.data.description!}
  enHref={hasVietnameseTranslation ? getBlogPostHref(englishEntry, "en") : undefined}
  translations={[
    {
      lang: "en",
      minutesRead: englishFrontmatter.minutesRead,
      pubDate: englishEntry.data.pubDate!,
      title: englishEntry.data.title,
    },
    ...(hasVietnameseTranslation && vietnameseFrontmatter
      ? [
          {
            lang: "vi" as const,
            minutesRead: vietnameseFrontmatter.minutesRead,
            pubDate: vietnameseVersion.data.pubDate!,
            title: vietnameseVersion.data.title,
          },
        ]
      : []),
  ]}
  url={`blog/${getCanonicalBlogId(englishEntry)}`}
  viHref={
    hasVietnameseTranslation ? getBlogPostHref(vietnameseVersion, "vi") : undefined
  }
>
  <EnglishContent slot="en" />
  {
    VietnameseContent && (
      <VietnameseContent slot="vi" />
    )
  }
</LayoutBlogPost>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;
  }

  h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 28px;
  }

  h3 {
    font-size: 24px;
  }

  h4 {
    font-size: 20px;
  }

  h5 {
    font-size: 18px;
  }

  h6 {
    font-size: 16px;
  }

  p {
    margin: 0 0 10px 0;
  }

  article a {
    color: var(--primary-400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration: underline;
  }

  ul,
  ol {
    margin-left: 20px;
    margin-bottom: 10px;
  }

  blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 5px solid #ccc;
  }

  article pre,
  article code {
    font-family: "Courier New", monospace;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
  }

  pre {
    padding: 10px;
    overflow-x: auto;
  }

  article code {
    padding: 2px 4px;
    font-size: 90%;
    color: var(--primary-300);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid #ddd;
  }
</style>
