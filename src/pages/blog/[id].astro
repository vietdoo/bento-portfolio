---
import { getCollection, render } from "astro:content";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";
import {
  getBlogPostHref,
  getBlogPostPaths,
  getCanonicalBlogId,
  getLocalizedPost,
} from "../../lib/blog-lang";
import { SITE } from "../../site-config";

export const prerender = true;

export async function getStaticPaths() {
  return getBlogPostPaths(await getCollection("blog"));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("id is missing");
}

const lang = Astro.url.searchParams.get("lang") === "vi" ? "vi" : "en";
const posts = await getCollection("blog");
const entry = getLocalizedPost(posts, id, lang);

if (!entry) {
  return Astro.redirect("/404");
}

const vietnameseVersion = getLocalizedPost(posts, id, "vi");
const hasVietnameseTranslation = vietnameseVersion?.data.lang === "vi";

const { Content, remarkPluginFrontmatter } = await render(entry);
---

<LayoutBlogPost
  description={entry.data.description!}
  enHref={hasVietnameseTranslation ? getBlogPostHref(entry, "en") : undefined}
  lang={entry.data.lang}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  pubDate={entry.data.pubDate!}
  title={`${entry.data.title} | ${SITE.author.fullName}`}
  url={`blog/${getCanonicalBlogId(entry)}`}
  viHref={hasVietnameseTranslation ? getBlogPostHref(entry, "vi") : undefined}
>
  <Content />
</LayoutBlogPost>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;
  }

  h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 28px;
  }

  h3 {
    font-size: 24px;
  }

  h4 {
    font-size: 20px;
  }

  h5 {
    font-size: 18px;
  }

  h6 {
    font-size: 16px;
  }

  p {
    margin: 0 0 10px 0;
  }

  article a {
    color: var(--primary-400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration: underline;
  }

  ul,
  ol {
    margin-left: 20px;
    margin-bottom: 10px;
  }

  blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 5px solid #ccc;
  }

  article pre,
  article code {
    font-family: "Courier New", monospace;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
  }

  pre {
    padding: 10px;
    overflow-x: auto;
  }

  article code {
    padding: 2px 4px;
    font-size: 90%;
    color: var(--primary-300);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid #ddd;
  }
</style>
