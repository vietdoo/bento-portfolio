---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { type Book } from "../data/books";
import { getLiveGoodreadsBooks } from "../lib/goodreads";

const booksData: Book[] = await getLiveGoodreadsBooks();

const readingBooks = booksData.filter((b) => b.status === "reading");
const completedBooks = booksData.filter((b) => b.status === "completed");
const wantToReadBooks = booksData.filter((b) => b.status === "want-to-read");

const avgRating = (
  booksData
    .filter((b) => b.rating)
    .reduce((acc, b) => acc + (b.rating || 0), 0) /
  booksData.filter((b) => b.rating).length
).toFixed(1);
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullName} - Bookshelf & Reading List`}
  description="Bộ sưu tập sách kỹ thuật IT, kiến trúc hệ thống và phát triển bản thân. Giao diện tối giản, tự động đồng bộ từ Goodreads profile."
>
  <!-- Modern Minimal Detail Modal -->
  <div
    id="book-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 p-4 sm:p-6"
    aria-hidden="true"
  >
    <div
      class="bg-darkslate-600/95 border border-white/10 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-2xl relative text-white transform scale-95 transition-all duration-300"
      id="modal-content"
    >
      <!-- Close Button -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 text-darkslate-300 hover:text-white transition-colors bg-darkslate-700/80 hover:bg-darkslate-500 border border-white/10 rounded-full w-8 h-8 flex items-center justify-center text-xs font-semibold z-10"
        aria-label="Close modal"
      >
        ✕
      </button>

      <!-- Modal Header -->
      <div class="flex flex-col sm:flex-row gap-6 mb-6 pb-6 border-b border-white/10">
        <div class="w-36 h-52 sm:w-40 sm:h-60 rounded-xl overflow-hidden shadow-lg border border-white/10 bg-darkslate-800 flex-shrink-0 mx-auto sm:mx-0">
          <img id="modal-cover" src="" alt="" class="w-full h-full object-cover" />
        </div>

        <div class="flex-1 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span id="modal-category" class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-primary-500/20 text-primary-400 border border-primary-500/30"></span>
              <span id="modal-status" class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full"></span>
            </div>
            <h2 id="modal-title" class="text-xl sm:text-2xl font-bold tracking-tight text-white mb-1"></h2>
            <p id="modal-subtitle" class="text-xs text-darkslate-300 mb-3 italic"></p>
            <p id="modal-author" class="text-xs font-semibold text-primary-400"></p>
          </div>

          <div class="space-y-2 pt-3 text-xs text-darkslate-300">
            <div id="modal-rating-container" class="flex items-center gap-1.5">
              <span class="text-amber-400 font-bold" id="modal-rating-stars"></span>
              <span id="modal-rating-val" class="font-semibold text-white"></span>
            </div>
            <div id="modal-progress-container" class="space-y-1 hidden">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-darkslate-300">Progress:</span>
                <span id="modal-progress-val" class="text-primary-400 font-bold"></span>
              </div>
              <div class="w-full h-1.5 bg-darkslate-800 rounded-full overflow-hidden border border-white/10">
                <div id="modal-progress-bar" class="h-full bg-primary-500 transition-all duration-500 rounded-full"></div>
              </div>
              <p id="modal-chapter" class="text-[11px] text-darkslate-300 mt-0.5"></p>
            </div>
            <div class="flex flex-wrap gap-4 text-darkslate-300 text-[11px] pt-1">
              <span id="modal-pages"></span>
              <span id="modal-year"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Detail content -->
      <div class="space-y-5 text-xs sm:text-sm">
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-wider text-darkslate-300 mb-1.5">Summary</h3>
          <p id="modal-summary" class="text-darkslate-100 leading-relaxed bg-darkslate-700/40 p-3.5 rounded-xl border border-white/5"></p>
        </div>

        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-wider text-darkslate-300 mb-1.5">Review &amp; Notes</h3>
          <p id="modal-review" class="text-darkslate-200 leading-relaxed"></p>
        </div>

        <div id="modal-quote-box" class="bg-primary-950/30 border-l-2 border-primary-500 p-3.5 rounded-r-xl my-3">
          <p id="modal-quote" class="text-primary-200 italic text-xs sm:text-sm leading-relaxed"></p>
        </div>

        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-wider text-darkslate-300 mb-2">Key Takeaways</h3>
          <ul id="modal-takeaways" class="space-y-1.5 list-none p-0 m-0 text-darkslate-200 text-xs"></ul>
        </div>

        <div class="pt-4 border-t border-white/10 flex flex-wrap justify-between items-center gap-3">
          <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
          <div class="flex gap-2">
            <a
              id="modal-goodreads-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-darkslate-700 hover:bg-darkslate-600 text-darkslate-200 border border-white/10 transition-colors"
            >
              Goodreads ↗
            </a>
            <a
              id="modal-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-primary-500 hover:bg-primary-600 text-white transition-colors"
            >
              Official ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-10 text-white">
    <BackLink href="/" class="mb-8" />

    <!-- Minimal Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-primary-500/20 text-primary-400 border border-primary-500/30">
            Reading Log
          </span>
        </div>

        <!-- Goodreads Sync Pill -->
        <a
          href={SITE.links.goodreads}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-darkslate-500/60 hover:bg-darkslate-500 border border-darkslate-400/60 text-xs text-darkslate-200 transition-all group"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Synced with <strong class="text-white group-hover:text-primary-400 transition-colors">goodreads.com/vietdoo</strong> ↗</span>
        </a>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">
        Bookshelf
      </h1>
      <p class="text-darkslate-300 text-sm max-w-xl leading-relaxed">
        A curated library of software engineering, system design, and personal development books I'm reading or have finished.
      </p>

      <!-- Minimal Stats Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
        <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-xl p-3 flex flex-col justify-between">
          <span class="text-[11px] text-darkslate-300 font-medium">Currently Reading 📖</span>
          <span class="text-xl font-bold text-sky-400 mt-1">{readingBooks.length} <span class="text-xs font-normal text-darkslate-300">books</span></span>
        </div>
        <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-xl p-3 flex flex-col justify-between">
          <span class="text-[11px] text-darkslate-300 font-medium">Completed ✅</span>
          <span class="text-xl font-bold text-emerald-400 mt-1">{completedBooks.length} <span class="text-xs font-normal text-darkslate-300">books</span></span>
        </div>
        <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-xl p-3 flex flex-col justify-between">
          <span class="text-[11px] text-darkslate-300 font-medium">Plan to Read 📌</span>
          <span class="text-xl font-bold text-amber-400 mt-1">{wantToReadBooks.length} <span class="text-xs font-normal text-darkslate-300">books</span></span>
        </div>
        <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-xl p-3 flex flex-col justify-between">
          <span class="text-[11px] text-darkslate-300 font-medium">Average Rating ⭐</span>
          <span class="text-xl font-bold text-amber-300 mt-1">{avgRating} <span class="text-xs font-normal text-darkslate-300">/ 5.0</span></span>
        </div>
      </div>
    </header>

    <!-- Controls Bar -->
    <section class="bg-darkslate-500/60 border border-darkslate-400/60 rounded-xl p-3.5 mb-8 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-3 justify-between items-stretch sm:items-center">
        <!-- Search Input -->
        <div class="relative flex-1">
          <svg class="w-4 h-4 absolute left-3 top-3 text-darkslate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Search books, authors, or topics..."
            class="w-full pl-9 pr-4 py-2 bg-darkslate-700/60 border border-darkslate-400/60 focus:border-primary-500 rounded-lg text-xs text-white placeholder-darkslate-300 outline-none transition-colors"
          />
        </div>

        <!-- Filter Tabs & View Switcher -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- View Mode Toggle (Grid vs Minimal List) -->
          <div class="flex bg-darkslate-700/50 p-1 rounded-lg border border-darkslate-400/40" id="view-mode-toggle">
            <button data-view="grid" class="view-btn active px-2.5 py-1 rounded text-xs font-semibold transition-all">Grid</button>
            <button data-view="list" class="view-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">List</button>
          </div>

          <!-- Category Filter -->
          <div class="flex bg-darkslate-700/50 p-1 rounded-lg border border-darkslate-400/40" id="category-filters">
            <button data-cat="all" class="cat-btn active px-2.5 py-1 rounded text-xs font-semibold transition-all">All</button>
            <button data-cat="tech" class="cat-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">Tech</button>
            <button data-cat="selfhelp" class="cat-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">Self-Help</button>
          </div>

          <!-- Status Filter -->
          <div class="flex bg-darkslate-700/50 p-1 rounded-lg border border-darkslate-400/40" id="status-filters">
            <button data-status="all" class="status-btn active px-2.5 py-1 rounded text-xs font-semibold transition-all">All Status</button>
            <button data-status="reading" class="status-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">Reading</button>
            <button data-status="completed" class="status-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">Read</button>
            <button data-status="want-to-read" class="status-btn px-2.5 py-1 rounded text-xs font-semibold text-darkslate-300 hover:text-white transition-all">Plan</button>
          </div>
        </div>
      </div>

      <div class="mt-2.5 text-[11px] text-darkslate-300 flex justify-between items-center pt-2 border-t border-white/5">
        <span>Showing <b id="visible-count" class="text-white">{booksData.length}</b> / {booksData.length} books</span>
        <span class="text-[10px] text-darkslate-300">Click any book for notes &amp; review</span>
      </div>
    </section>

    <!-- SECTION 1: MINIMAL GRID VIEW -->
    <section id="grid-view-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {booksData.map((book) => (
        <article
          class="book-card group bg-darkslate-500/60 border border-darkslate-400/60 hover:border-primary-500 rounded-xl p-4 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-xl cursor-pointer relative overflow-hidden"
          data-id={book.id}
          data-category={book.category}
          data-status={book.status}
          data-title={book.title.toLowerCase()}
          data-author={book.author.toLowerCase()}
          data-tags={book.tags.join(" ").toLowerCase()}
        >
          <div>
            <!-- Cover Container -->
            <div class="relative w-full aspect-[2/3] rounded-lg overflow-hidden mb-3.5 shadow-md border border-white/10 bg-darkslate-800">
              <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />

              <!-- Category Badge -->
              <span class="absolute top-2 left-2 px-2 py-0.5 text-[9px] font-semibold rounded bg-black/75 backdrop-blur-md text-white border border-white/10 uppercase tracking-wider">
                {book.category === "tech" ? "Tech" : "Self-Help"}
              </span>

              <!-- Status Badge -->
              <span
                class={`absolute top-2 right-2 px-2 py-0.5 text-[9px] font-semibold rounded-full backdrop-blur-md border flex items-center gap-1 ${
                  book.status === "reading"
                    ? "bg-sky-950/80 text-sky-400 border-sky-500/40"
                    : book.status === "completed"
                    ? "bg-emerald-950/80 text-emerald-400 border-emerald-500/40"
                    : "bg-amber-950/80 text-amber-400 border-amber-500/40"
                }`}
              >
                {book.status === "reading" && <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>}
                {book.statusLabel}
              </span>
            </div>

            <!-- Book Info -->
            <h3 class="text-sm font-bold text-white tracking-tight leading-snug group-hover:text-primary-400 transition-colors line-clamp-2 mb-1">
              {book.title}
            </h3>
            <p class="text-xs font-medium text-darkslate-300 mb-2.5">{book.author}</p>

            <!-- Progress bar or Rating -->
            {book.status === "reading" && book.progress && (
              <div class="bg-darkslate-700/50 border border-white/5 rounded-lg p-2 mb-2.5">
                <div class="flex justify-between text-[10px] font-semibold mb-1">
                  <span class="text-sky-400">Progress</span>
                  <span class="text-white">{book.progress}%</span>
                </div>
                <div class="w-full h-1 bg-darkslate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-primary-500 rounded-full" style={`width: ${book.progress}%`}></div>
                </div>
              </div>
            )}

            {book.status === "completed" && book.rating && (
              <div class="flex items-center gap-1 mb-2.5 text-xs">
                <span class="text-amber-400 font-bold">★ {book.rating.toFixed(1)}</span>
                <span class="text-darkslate-300 text-[10px]">/ 5.0</span>
              </div>
            )}

            <!-- Quote preview -->
            {book.quote && (
              <p class="text-[11px] text-darkslate-300 italic line-clamp-2 mb-2.5 bg-darkslate-700/30 p-2 rounded-lg border border-white/5">
                "{book.quote}"
              </p>
            )}
          </div>

          <!-- Card Footer -->
          <div class="pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-darkslate-300 font-medium group-hover:text-white transition-colors">
            <span>Notes &amp; Review</span>
            <span class="text-primary-400 group-hover:translate-x-0.5 transition-transform">Details →</span>
          </div>
        </article>
      ))}
    </section>

    <!-- SECTION 2: CLEAN MINIMAL LIST VIEW -->
    <section id="list-view-container" class="hidden space-y-2.5">
      {booksData.map((book) => (
        <article
          class="book-card group bg-darkslate-500/50 border border-darkslate-400/60 hover:border-primary-500 rounded-xl p-3.5 flex items-center justify-between gap-4 transition-all duration-200 hover:bg-darkslate-500/80 cursor-pointer"
          data-id={book.id}
          data-category={book.category}
          data-status={book.status}
          data-title={book.title.toLowerCase()}
          data-author={book.author.toLowerCase()}
          data-tags={book.tags.join(" ").toLowerCase()}
        >
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="w-10 h-14 rounded overflow-hidden flex-shrink-0 bg-darkslate-800 border border-white/10">
              <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
            </div>

            <div class="min-w-0">
              <h3 class="text-sm font-bold text-white truncate group-hover:text-primary-400 transition-colors">
                {book.title}
              </h3>
              <p class="text-xs text-darkslate-300 truncate">{book.author}</p>
            </div>
          </div>

          <div class="flex items-center gap-3 flex-shrink-0 text-xs">
            <span class="hidden sm:inline-block px-2 py-0.5 text-[10px] font-medium rounded bg-darkslate-700 text-darkslate-300 border border-white/10 uppercase">
              {book.category === "tech" ? "Tech" : "Self-Help"}
            </span>

            {book.rating && (
              <span class="text-amber-400 font-semibold text-xs hidden md:inline-block">★ {book.rating.toFixed(1)}</span>
            )}

            <span
              class={`px-2.5 py-0.5 text-[10px] font-semibold rounded-full border ${
                book.status === "reading"
                  ? "bg-sky-950/80 text-sky-400 border-sky-500/40"
                  : book.status === "completed"
                  ? "bg-emerald-950/80 text-emerald-400 border-emerald-500/40"
                  : "bg-amber-950/80 text-amber-400 border-amber-500/40"
              }`}
            >
              {book.statusLabel}
            </span>

            <span class="text-darkslate-300 group-hover:text-primary-400 transition-colors">→</span>
          </div>
        </article>
      ))}
    </section>

    <!-- Empty state -->
    <div id="no-results" class="hidden text-center py-16 bg-darkslate-500/40 rounded-xl border border-darkslate-400/60 mt-6">
      <p class="text-base font-semibold text-white mb-1">No books found</p>
      <p class="text-xs text-darkslate-300">Try clearing filters or searching for a different keyword.</p>
    </div>

    <!-- Goodreads Footer Attribution -->
    <footer class="mt-16 pt-6 border-t border-darkslate-400/40 text-center text-xs text-darkslate-300">
      <p>
        Data &amp; Image Source: Synced continuously from my <a href={SITE.links.goodreads} target="_blank" rel="noopener noreferrer" class="text-primary-400 font-medium underline hover:text-primary-300">Goodreads Profile (@vietdoo)</a> &amp; Open Library API.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .cat-btn.active, .status-btn.active, .view-btn.active {
    background-color: var(--primary-500) !important;
    color: #ffffff !important;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--primary-500) 40%, transparent);
  }
</style>

<script is:inline define:vars={{ booksData }}>
  (function initBookshelf() {
    let currentCat = 'all';
    let currentStatus = 'all';
    let searchQuery = '';
    let currentView = 'grid';

    const cards = document.querySelectorAll('.book-card');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-results');
    const searchInput = document.getElementById('search-input');
    const gridContainer = document.getElementById('grid-view-container');
    const listContainer = document.getElementById('list-view-container');

    // View Mode Switcher (Grid vs List)
    document.querySelectorAll('#view-mode-toggle .view-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#view-mode-toggle .view-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentView = btn.dataset.view;

        if (currentView === 'grid') {
          gridContainer.classList.remove('hidden');
          listContainer.classList.add('hidden');
        } else {
          gridContainer.classList.add('hidden');
          listContainer.classList.remove('hidden');
        }
      });
    });

    // Filter Logic
    function filterBooks() {
      let count = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category;
        const status = card.dataset.status;
        const title = card.dataset.title;
        const author = card.dataset.author;
        const tags = card.dataset.tags;

        const matchCat = currentCat === 'all' || cat === currentCat;
        const matchStatus = currentStatus === 'all' || status === currentStatus;
        const matchSearch =
          !searchQuery ||
          title.includes(searchQuery) ||
          author.includes(searchQuery) ||
          tags.includes(searchQuery);

        if (matchCat && matchStatus && matchSearch) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Divide count by 2 since cards exist in both grid and list view
      const actualVisible = Math.ceil(count / 2);

      if (visibleCountEl) visibleCountEl.textContent = actualVisible;
      if (noResultsEl) {
        if (actualVisible === 0) noResultsEl.classList.remove('hidden');
        else noResultsEl.classList.add('hidden');
      }
    }

    // Category Tabs
    document.querySelectorAll('#category-filters .cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#category-filters .cat-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.dataset.cat;
        filterBooks();
      });
    });

    // Status Tabs
    document.querySelectorAll('#status-filters .status-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#status-filters .status-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentStatus = btn.dataset.status;
        filterBooks();
      });
    });

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterBooks();
      });
    }

    // Modal Logic
    const modal = document.getElementById('book-modal');
    const modalContent = document.getElementById('modal-content');
    const modalClose = document.getElementById('modal-close');

    function openModal(book) {
      if (!modal || !book) return;

      document.getElementById('modal-cover').src = book.coverImage;
      document.getElementById('modal-cover').alt = book.title;
      document.getElementById('modal-title').textContent = book.title;
      document.getElementById('modal-subtitle').textContent = book.subtitle || '';
      document.getElementById('modal-author').textContent = `By ${book.author}`;
      document.getElementById('modal-category').textContent = book.categoryLabel;

      const statusEl = document.getElementById('modal-status');
      statusEl.textContent = book.statusLabel;
      if (book.status === 'reading') {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-sky-950/80 text-sky-400 border border-sky-500/40';
      } else if (book.status === 'completed') {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-500/40';
      } else {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-amber-950/80 text-amber-400 border border-amber-500/40';
      }

      const ratingContainer = document.getElementById('modal-rating-container');
      const progressContainer = document.getElementById('modal-progress-container');

      if (book.rating) {
        ratingContainer.classList.remove('hidden');
        document.getElementById('modal-rating-stars').textContent = '★'.repeat(Math.floor(book.rating));
        document.getElementById('modal-rating-val').textContent = `${book.rating.toFixed(1)} / 5.0`;
      } else {
        ratingContainer.classList.add('hidden');
      }

      if (book.status === 'reading' && book.progress) {
        progressContainer.classList.remove('hidden');
        document.getElementById('modal-progress-val').textContent = `${book.progress}%`;
        document.getElementById('modal-progress-bar').style.width = `${book.progress}%`;
        document.getElementById('modal-chapter').textContent = book.currentChapter || '';
      } else {
        progressContainer.classList.add('hidden');
      }

      document.getElementById('modal-pages').textContent = book.pages ? `📄 ${book.pages} pages` : '';
      document.getElementById('modal-year').textContent = book.yearRead ? `📅 Read in ${book.yearRead}` : '';
      document.getElementById('modal-summary').textContent = book.summary;
      document.getElementById('modal-review').textContent = book.review;

      const quoteBox = document.getElementById('modal-quote-box');
      if (book.quote) {
        quoteBox.classList.remove('hidden');
        document.getElementById('modal-quote').textContent = `"${book.quote}"`;
      } else {
        quoteBox.classList.add('hidden');
      }

      const takeawaysEl = document.getElementById('modal-takeaways');
      takeawaysEl.innerHTML = '';
      if (book.keyTakeaways && book.keyTakeaways.length > 0) {
        book.keyTakeaways.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 text-xs leading-relaxed bg-darkslate-700/40 p-2.5 rounded-lg border border-white/5';
          li.innerHTML = `<span class="text-primary-400 font-bold text-sm">✓</span> <span>${t}</span>`;
          takeawaysEl.appendChild(li);
        });
      }

      const tagsEl = document.getElementById('modal-tags');
      tagsEl.innerHTML = '';
      if (book.tags) {
        book.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'px-2 py-0.5 text-[10px] font-semibold rounded bg-darkslate-700 text-darkslate-300 border border-white/10';
          span.textContent = `#${tag}`;
          tagsEl.appendChild(span);
        });
      }

      const grLinkEl = document.getElementById('modal-goodreads-link');
      if (grLinkEl) {
        grLinkEl.href = book.goodreadsUrl || 'https://www.goodreads.com/vietdoo';
      }

      const linkEl = document.getElementById('modal-link');
      if (book.link) {
        linkEl.href = book.link;
        linkEl.classList.remove('hidden');
      } else {
        linkEl.classList.add('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalContent.classList.add('scale-95');
      modalContent.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const book = booksData.find((b) => b.id === id);
        if (book) openModal(book);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>
