---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { booksData, type Book } from "../data/books";

const readingBooks = booksData.filter((b) => b.status === "reading");
const completedBooks = booksData.filter((b) => b.status === "completed");
const wantToReadBooks = booksData.filter((b) => b.status === "want-to-read");

const avgRating = (
  booksData
    .filter((b) => b.rating)
    .reduce((acc, b) => acc + (b.rating || 0), 0) /
  booksData.filter((b) => b.rating).length
).toFixed(1);
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullName} - Classic Bookshelf & Personal Library`}
  description="Bộ sưu tập sách kỹ thuật IT, kiến trúc hệ thống dữ liệu và phát triển bản thân. Tự động đồng bộ từ Goodreads profile."
>
  <!-- Modal Detail Journal View -->
  <div
    id="book-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-lg opacity-0 pointer-events-none transition-all duration-300 p-4 sm:p-6"
    aria-hidden="true"
  >
    <div
      class="bg-gradient-to-b from-[#1c120a] to-[#120b06] border-2 border-amber-800/60 rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-[0_25px_70px_rgba(0,0,0,0.95)] relative text-amber-50 transform scale-95 transition-all duration-300 font-serif"
      id="modal-content"
    >
      <!-- Close Button -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 text-amber-400/80 hover:text-amber-100 transition-colors bg-amber-950/80 hover:bg-amber-900 border border-amber-700/60 rounded-full w-9 h-9 flex items-center justify-center text-sm font-bold z-10 shadow-lg"
        aria-label="Close modal"
      >
        ✕
      </button>

      <!-- Modal Header Info -->
      <div class="flex flex-col sm:flex-row gap-6 mb-6 pb-6 border-b border-amber-900/40">
        <!-- Book Cover in Modal -->
        <div class="w-36 h-52 sm:w-44 sm:h-64 rounded-xl overflow-hidden shadow-[0_15px_35px_rgba(0,0,0,0.9)] border border-amber-600/50 bg-amber-950 flex-shrink-0 mx-auto sm:mx-0 relative group">
          <img id="modal-cover" src="" alt="" class="w-full h-full object-cover" />
          <div class="absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/60 to-transparent"></div>
        </div>

        <div class="flex-1 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3 font-sans">
              <span id="modal-category" class="px-3 py-1 text-[11px] font-bold rounded-md bg-amber-950/90 text-amber-300 border border-amber-700/60 uppercase tracking-wider"></span>
              <span id="modal-status" class="px-3 py-1 text-[11px] font-bold rounded-md uppercase tracking-wider"></span>
            </div>
            <h2 id="modal-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-amber-100 mb-1 leading-tight"></h2>
            <p id="modal-subtitle" class="text-xs text-amber-300/80 mb-3 italic font-sans"></p>
            <p id="modal-author" class="text-sm font-semibold text-amber-400 tracking-wide"></p>
          </div>

          <div class="space-y-2 pt-3 font-sans text-xs text-amber-200/80">
            <div id="modal-rating-container" class="flex items-center gap-1.5">
              <span class="text-amber-400 text-sm font-bold" id="modal-rating-stars"></span>
              <span id="modal-rating-val" class="font-semibold text-amber-100"></span>
            </div>
            <div id="modal-progress-container" class="space-y-1.5 hidden">
              <div class="flex justify-between text-xs font-semibold">
                <span class="text-amber-300/70">Tiến độ đọc:</span>
                <span id="modal-progress-val" class="text-amber-400 font-bold"></span>
              </div>
              <div class="w-full h-2 bg-amber-950 rounded-full overflow-hidden border border-amber-800/40">
                <div id="modal-progress-bar" class="h-full bg-gradient-to-r from-amber-600 via-amber-500 to-amber-300 transition-all duration-500 rounded-full shadow-[0_0_10px_#f59e0b]"></div>
              </div>
              <p id="modal-chapter" class="text-[11px] text-amber-300/70 mt-0.5"></p>
            </div>
            <div class="flex flex-wrap gap-4 text-amber-300/70 text-[12px] pt-1">
              <span id="modal-pages"></span>
              <span id="modal-year"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Journal content sections -->
      <div class="space-y-6 text-sm">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-amber-400/90 mb-2 font-sans flex items-center gap-2">
            <span>📜</span> Tóm Tắt Tác Phẩm
          </h3>
          <p id="modal-summary" class="text-amber-100/90 leading-relaxed bg-amber-950/40 p-4 rounded-2xl border border-amber-900/40 text-sm shadow-inner"></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-amber-400/90 mb-2 font-sans flex items-center gap-2">
            <span>✍️</span> Đánh Giá &amp; Ghi Chú Cá Nhân
          </h3>
          <p id="modal-review" class="text-amber-100/90 leading-relaxed text-sm"></p>
        </div>

        <div id="modal-quote-box" class="bg-gradient-to-r from-amber-950/70 via-amber-900/40 to-transparent border-l-4 border-amber-500 p-4.5 rounded-r-2xl my-4 shadow-md">
          <p id="modal-quote" class="text-amber-200 italic text-base leading-relaxed"></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-amber-400/90 mb-3 font-sans flex items-center gap-2">
            <span>💡</span> Bài Học Cốt Lõi (Key Takeaways)
          </h3>
          <ul id="modal-takeaways" class="space-y-2 list-none p-0 m-0 text-amber-100/90 font-sans text-xs"></ul>
        </div>

        <div class="pt-5 border-t border-amber-900/40 flex flex-wrap justify-between items-center gap-3 font-sans">
          <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
          <div class="flex gap-2">
            <a
              id="modal-goodreads-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-xl bg-amber-950 hover:bg-amber-900 text-amber-200 border border-amber-700/60 transition-all shadow-md uppercase tracking-wider"
            >
              Goodreads ↗
            </a>
            <a
              id="modal-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-xl bg-amber-600 hover:bg-amber-500 text-amber-95 transition-all shadow-md uppercase tracking-wider"
            >
              Trang Chủ ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-10 text-amber-50 min-h-screen relative">
    <!-- Ambient Warm Library Lighting Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-b from-amber-600/15 via-amber-700/5 to-transparent blur-3xl -z-10 pointer-events-none"></div>

    <BackLink href="/" class="mb-8" />

    <!-- Classic Library Header -->
    <header class="mb-12 text-center sm:text-left border-b border-amber-900/40 pb-8">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4 font-sans">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-950/80 border border-amber-800/60 text-amber-300 text-xs font-bold uppercase tracking-widest shadow-md">
          <span>🏛️</span> Personal Library &amp; Archives
        </div>

        <!-- Goodreads Sync Badge -->
        <a
          href={SITE.links.goodreads}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 hover:text-emerald-100 hover:bg-emerald-900/90 text-xs font-semibold transition-all shadow-lg group"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Synced from <strong class="underline decoration-emerald-500/50 group-hover:decoration-emerald-300">Goodreads Profile</strong> ↗</span>
        </a>
      </div>

      <h1 class="text-4xl sm:text-6xl font-serif font-extrabold text-amber-100 tracking-tight mb-4 leading-tight">
        The Classic Bookshelf
      </h1>
      <p class="text-amber-200/90 font-serif text-base sm:text-lg max-w-3xl leading-relaxed italic">
        "Sách là ngọn đèn hải đăng chiếu sáng kiến trúc tư duy." Nơi lưu giữ các ấn phẩm kỹ thuật phần mềm, hệ thống dữ liệu phân tán và tri thức phát triển bản thân.
      </p>

      <!-- Sync Info Notice -->
      <div class="mt-5 p-4 bg-gradient-to-r from-amber-950/50 via-amber-900/20 to-transparent border border-amber-900/40 rounded-2xl flex items-center gap-3.5 text-xs font-sans text-amber-300/90 max-w-2xl shadow-inner">
        <span class="text-xl flex-shrink-0">🔄</span>
        <span class="leading-relaxed">
          <strong>Data &amp; Image Source:</strong> Danh sách sách, tiến độ đọc và đánh giá được tự động đồng bộ trực tiếp từ tài khoản <a href={SITE.links.goodreads} target="_blank" rel="noopener noreferrer" class="text-amber-200 font-bold underline hover:text-amber-400">Goodreads Profile (@vietdoo)</a> &amp; Open Library API.
        </span>
      </div>

      <!-- Vintage Brass Stats Counter -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 font-sans">
        <div class="bg-gradient-to-b from-[#22160d] to-[#140c06] border border-amber-900/60 rounded-2xl p-4.5 shadow-xl text-center sm:text-left hover:border-amber-700/60 transition-all">
          <span class="text-xs text-blue-400 uppercase font-bold tracking-wider">Đang đọc 📖</span>
          <p class="text-3xl font-bold text-amber-100 mt-1 font-serif">{readingBooks.length} <span class="text-xs font-normal text-amber-400/70 font-sans">cuốn</span></p>
        </div>
        <div class="bg-gradient-to-b from-[#22160d] to-[#140c06] border border-amber-900/60 rounded-2xl p-4.5 shadow-xl text-center sm:text-left hover:border-emerald-700/60 transition-all">
          <span class="text-xs text-emerald-400 uppercase font-bold tracking-wider">Đã đọc ✅</span>
          <p class="text-3xl font-bold text-emerald-300 mt-1 font-serif">{completedBooks.length} <span class="text-xs font-normal text-amber-400/70 font-sans">cuốn</span></p>
        </div>
        <div class="bg-gradient-to-b from-[#22160d] to-[#140c06] border border-amber-900/60 rounded-2xl p-4.5 shadow-xl text-center sm:text-left hover:border-amber-700/60 transition-all">
          <span class="text-xs text-amber-400 uppercase font-bold tracking-wider">Dự định đọc 📌</span>
          <p class="text-3xl font-bold text-amber-300 mt-1 font-serif">{wantToReadBooks.length} <span class="text-xs font-normal text-amber-400/70 font-sans">cuốn</span></p>
        </div>
        <div class="bg-gradient-to-b from-[#22160d] to-[#140c06] border border-amber-900/60 rounded-2xl p-4.5 shadow-xl text-center sm:text-left hover:border-amber-700/60 transition-all">
          <span class="text-xs text-amber-300 uppercase font-bold tracking-wider">Đánh giá TB ⭐</span>
          <p class="text-3xl font-bold text-amber-300 mt-1 font-serif">{avgRating} <span class="text-xs font-normal text-amber-400/70 font-sans">/ 5.0</span></p>
        </div>
      </div>
    </header>

    <!-- Controls Filter Bar -->
    <section class="bg-[#1a110a] border border-amber-900/60 rounded-2xl p-4 sm:p-5 mb-10 shadow-2xl font-sans">
      <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
        <!-- Search Input -->
        <div class="relative flex-1">
          <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-amber-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Tìm tên sách, tác giả hoặc từ khóa..."
            class="w-full pl-10 pr-4 py-2.5 bg-[#100a06] border border-amber-900/60 focus:border-amber-500 rounded-xl text-xs sm:text-sm text-amber-100 placeholder-amber-600/60 outline-none transition-colors"
          />
        </div>

        <!-- Filter Tabs & View Mode Switcher -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- View Switcher -->
          <div class="flex bg-[#100a06] p-1 rounded-xl border border-amber-900/60 shadow-inner" id="view-mode-toggle">
            <button data-view="shelf" class="view-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
              <span>🪵</span> Giá Sách Gỗ
            </button>
            <button data-view="grid" class="view-btn px-3.5 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all flex items-center gap-1.5">
              <span>📜</span> Thư Viện
            </button>
          </div>

          <!-- Category Filter -->
          <div class="flex bg-[#100a06] p-1 rounded-xl border border-amber-900/60 shadow-inner" id="category-filters">
            <button data-cat="all" class="cat-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all">Tất cả</button>
            <button data-cat="tech" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all">💻 Tech IT</button>
            <button data-cat="selfhelp" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all">💡 Self-Help</button>
          </div>

          <!-- Status Filter -->
          <div class="flex bg-[#100a06] p-1 rounded-xl border border-amber-900/60 shadow-inner" id="status-filters">
            <button data-status="all" class="status-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all">Tất cả trạng thái</button>
            <button data-status="reading" class="status-btn px-3 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all">📖 Đang đọc</button>
            <button data-status="completed" class="status-btn px-3 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all">✅ Đã đọc</button>
            <button data-status="want-to-read" class="status-btn px-3 py-1.5 rounded-lg text-xs font-bold text-amber-400/70 hover:text-amber-200 transition-all">📌 Dự định</button>
          </div>
        </div>
      </div>

      <div class="mt-3 text-xs text-amber-400/70 flex justify-between items-center pt-2 border-t border-amber-900/30">
        <span>Hiển thị <b id="visible-count" class="text-amber-200">{booksData.length}</b> / {booksData.length} cuốn sách</span>
        <span class="text-[11px] text-amber-400/60 italic font-serif">💡 Click vào bất kỳ cuốn sách nào để đọc nhật ký cảm nhận</span>
      </div>
    </section>

    <!-- SECTION 1: PHYSICAL WOODEN SHELF VIEW -->
    <section id="shelf-view-container" class="space-y-16 mb-16">
      <!-- Shelf Group 1: Currently Reading -->
      <div class="shelf-group" id="shelf-group-reading">
        <div class="flex items-center gap-2.5 mb-4 font-serif">
          <span class="w-3.5 h-3.5 rounded-full bg-blue-500 shadow-[0_0_12px_#3b82f6] animate-pulse"></span>
          <h2 class="text-2xl font-bold text-amber-100 tracking-wide">Đang Đọc (Currently Reading)</h2>
          <span class="text-xs text-amber-400/60 font-sans">({readingBooks.length} cuốn)</span>
        </div>

        <div class="relative bg-gradient-to-b from-[#180f0a] via-[#120a06] to-[#0c0603] p-6 pt-12 rounded-t-3xl border-t border-x border-amber-900/50 shadow-2xl">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 items-end justify-items-center">
            {readingBooks.map((book) => (
              <div
                class="book-card book-shelf-item group cursor-pointer relative flex flex-col items-center transition-all duration-300 hover:-translate-y-5 hover:scale-105"
                data-id={book.id}
                data-category={book.category}
                data-status={book.status}
                data-title={book.title.toLowerCase()}
                data-author={book.author.toLowerCase()}
                data-tags={book.tags.join(" ").toLowerCase()}
              >
                <!-- Blue Silk Ribbon Bookmark -->
                <div class="absolute -top-3.5 right-4 z-20 w-3.5 h-11 bg-gradient-to-b from-blue-500 to-blue-800 shadow-lg rounded-t-sm flex items-end justify-center pb-1">
                  <div class="w-1.5 h-1.5 border-b-2 border-r-2 border-amber-200 transform rotate-45"></div>
                </div>

                <!-- 3D Book Cover -->
                <div class="w-32 h-48 sm:w-36 sm:h-54 rounded-r-lg rounded-l-sm overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.9)] border border-amber-700/50 relative bg-amber-950 group-hover:shadow-[0_25px_50px_rgba(59,130,246,0.35)] transition-all">
                  <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/65 to-transparent"></div>
                  <div class="absolute bottom-2 inset-x-2 bg-black/85 backdrop-blur-md border border-blue-500/50 rounded-md px-2 py-1 text-[10px] font-sans text-center text-blue-300 font-bold shadow-md">
                    {book.progress}% • Ch. 10
                  </div>
                </div>

                <p class="text-[11px] font-serif font-bold text-amber-200 text-center mt-2.5 line-clamp-1 group-hover:text-blue-300 transition-colors w-32 sm:w-36">
                  {book.title}
                </p>
                <p class="text-[10px] font-sans text-amber-400/60 text-center">{book.author}</p>
              </div>
            ))}
          </div>
          <!-- Wooden Shelf Base Rack -->
          <div class="w-full h-6 mt-5 bg-gradient-to-r from-[#29170c] via-[#482813] to-[#29170c] border-t-2 border-b border-amber-600/60 shadow-2xl rounded-sm flex items-center justify-between px-6">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
          </div>
        </div>
      </div>

      <!-- Shelf Group 2: Completed Books -->
      <div class="shelf-group" id="shelf-group-completed">
        <div class="flex items-center gap-2.5 mb-4 font-serif">
          <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 shadow-[0_0_12px_#10b981]"></span>
          <h2 class="text-2xl font-bold text-amber-100 tracking-wide">Đã Hoàn Thành (Completed Works)</h2>
          <span class="text-xs text-amber-400/60 font-sans">({completedBooks.length} cuốn)</span>
        </div>

        <div class="relative bg-gradient-to-b from-[#180f0a] via-[#120a06] to-[#0c0603] p-6 pt-12 rounded-t-3xl border-t border-x border-amber-900/50 shadow-2xl">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 items-end justify-items-center">
            {completedBooks.map((book) => (
              <div
                class="book-card book-shelf-item group cursor-pointer relative flex flex-col items-center transition-all duration-300 hover:-translate-y-5 hover:scale-105"
                data-id={book.id}
                data-category={book.category}
                data-status={book.status}
                data-title={book.title.toLowerCase()}
                data-author={book.author.toLowerCase()}
                data-tags={book.tags.join(" ").toLowerCase()}
              >
                <!-- Gold Silk Ribbon Bookmark -->
                <div class="absolute -top-3.5 right-4 z-20 w-3.5 h-11 bg-gradient-to-b from-amber-500 to-amber-700 shadow-lg rounded-t-sm flex items-end justify-center pb-1">
                  <div class="w-1.5 h-1.5 border-b-2 border-r-2 border-amber-100 transform rotate-45"></div>
                </div>

                <div class="w-32 h-48 sm:w-36 sm:h-54 rounded-r-lg rounded-l-sm overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.9)] border border-amber-700/50 relative bg-amber-950 group-hover:shadow-[0_25px_50px_rgba(245,158,11,0.35)] transition-all">
                  <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/65 to-transparent"></div>
                  {book.rating && (
                    <div class="absolute bottom-2 inset-x-2 bg-black/85 backdrop-blur-md border border-amber-500/50 rounded-md px-2 py-0.5 text-[10px] font-sans text-center text-amber-300 font-bold shadow-md">
                      ★ {book.rating.toFixed(1)} / 5.0
                    </div>
                  )}
                </div>

                <p class="text-[11px] font-serif font-bold text-amber-200 text-center mt-2.5 line-clamp-1 group-hover:text-amber-300 transition-colors w-32 sm:w-36">
                  {book.title}
                </p>
                <p class="text-[10px] font-sans text-amber-400/60 text-center">{book.author}</p>
              </div>
            ))}
          </div>
          <!-- Wooden Shelf Base Rack -->
          <div class="w-full h-6 mt-5 bg-gradient-to-r from-[#29170c] via-[#482813] to-[#29170c] border-t-2 border-b border-amber-600/60 shadow-2xl rounded-sm flex items-center justify-between px-6">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
          </div>
        </div>
      </div>

      <!-- Shelf Group 3: Want To Read -->
      <div class="shelf-group" id="shelf-group-want">
        <div class="flex items-center gap-2.5 mb-4 font-serif">
          <span class="w-3.5 h-3.5 rounded-full bg-amber-500"></span>
          <h2 class="text-2xl font-bold text-amber-100 tracking-wide">Dự Định Đọc (Plan to Read)</h2>
          <span class="text-xs text-amber-400/60 font-sans">({wantToReadBooks.length} cuốn)</span>
        </div>

        <div class="relative bg-gradient-to-b from-[#180f0a] via-[#120a06] to-[#0c0603] p-6 pt-12 rounded-t-3xl border-t border-x border-amber-900/50 shadow-2xl">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 items-end justify-items-center">
            {wantToReadBooks.map((book) => (
              <div
                class="book-card book-shelf-item group cursor-pointer relative flex flex-col items-center transition-all duration-300 hover:-translate-y-5 hover:scale-105"
                data-id={book.id}
                data-category={book.category}
                data-status={book.status}
                data-title={book.title.toLowerCase()}
                data-author={book.author.toLowerCase()}
                data-tags={book.tags.join(" ").toLowerCase()}
              >
                <!-- Bronze Ribbon Bookmark -->
                <div class="absolute -top-3.5 right-4 z-20 w-3.5 h-11 bg-gradient-to-b from-amber-700 to-amber-900 shadow-lg rounded-t-sm flex items-end justify-center pb-1">
                  <div class="w-1.5 h-1.5 border-b-2 border-r-2 border-amber-300 transform rotate-45"></div>
                </div>

                <div class="w-32 h-48 sm:w-36 sm:h-54 rounded-r-lg rounded-l-sm overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.9)] border border-amber-700/50 relative bg-amber-950 group-hover:shadow-[0_25px_50px_rgba(217,119,6,0.35)] transition-all opacity-90 group-hover:opacity-100">
                  <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/65 to-transparent"></div>
                  <div class="absolute bottom-2 inset-x-2 bg-black/85 backdrop-blur-md border border-amber-600/50 rounded-md px-2 py-0.5 text-[10px] font-sans text-center text-amber-400 font-bold shadow-md">
                    📌 Dự định
                  </div>
                </div>

                <p class="text-[11px] font-serif font-bold text-amber-200 text-center mt-2.5 line-clamp-1 group-hover:text-amber-300 transition-colors w-32 sm:w-36">
                  {book.title}
                </p>
                <p class="text-[10px] font-sans text-amber-400/60 text-center">{book.author}</p>
              </div>
            ))}
          </div>
          <!-- Wooden Shelf Base Rack -->
          <div class="w-full h-6 mt-5 bg-gradient-to-r from-[#29170c] via-[#482813] to-[#29170c] border-t-2 border-b border-amber-600/60 shadow-2xl rounded-sm flex items-center justify-between px-6">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-800/60 shadow-inner"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: EDITORIAL GRID VIEW -->
    <section id="grid-view-container" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 font-serif">
      {booksData.map((book) => (
        <article
          class="book-card group bg-gradient-to-b from-[#1c1109] to-[#120a05] border border-amber-900/60 hover:border-amber-500/80 rounded-3xl p-5 flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_45px_rgba(0,0,0,0.9)] cursor-pointer relative overflow-hidden"
          data-id={book.id}
          data-category={book.category}
          data-status={book.status}
          data-title={book.title.toLowerCase()}
          data-author={book.author.toLowerCase()}
          data-tags={book.tags.join(" ").toLowerCase()}
        >
          <div>
            <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden mb-4 shadow-2xl border border-amber-700/50 bg-amber-950">
              <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/60 to-transparent"></div>

              <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 text-[9px] font-bold rounded-md bg-black/80 backdrop-blur-md text-amber-300 border border-amber-700/60 font-sans uppercase tracking-wider">
                {book.category === "tech" ? "Tech IT" : "Self-Help"}
              </span>

              <span
                class={`absolute top-2.5 right-2.5 px-2.5 py-0.5 text-[9px] font-bold rounded-full backdrop-blur-md border shadow-md font-sans uppercase ${
                  book.status === "reading"
                    ? "bg-blue-950/90 text-blue-300 border-blue-500/50"
                    : book.status === "completed"
                    ? "bg-emerald-950/90 text-emerald-300 border-emerald-500/50"
                    : "bg-amber-950/90 text-amber-300 border-amber-500/50"
                }`}
              >
                {book.statusLabel}
              </span>
            </div>

            <h3 class="text-base font-bold text-amber-100 tracking-tight leading-snug group-hover:text-amber-300 transition-colors line-clamp-2 mb-1">
              {book.title}
            </h3>
            <p class="text-xs font-sans text-amber-400/70 mb-3">{book.author}</p>

            {book.status === "reading" && book.progress && (
              <div class="bg-[#120a05] border border-amber-900/50 rounded-xl p-2.5 mb-3 font-sans">
                <div class="flex justify-between text-[11px] font-semibold mb-1">
                  <span class="text-blue-400">Tiến độ</span>
                  <span class="text-amber-200">{book.progress}%</span>
                </div>
                <div class="w-full h-1.5 bg-amber-950 rounded-full overflow-hidden">
                  <div class="h-full bg-blue-500 rounded-full" style={`width: ${book.progress}%`}></div>
                </div>
              </div>
            )}

            {book.status === "completed" && book.rating && (
              <div class="flex items-center gap-1 mb-3 text-xs font-sans">
                <span class="text-amber-400 font-bold">★ {book.rating.toFixed(1)}</span>
                <span class="text-amber-400/60 text-[11px]">/ 5.0</span>
              </div>
            )}

            {book.quote && (
              <p class="text-[11px] text-amber-200/80 italic line-clamp-2 mb-3 bg-amber-950/50 p-2.5 rounded-xl border border-amber-900/40">
                "{book.quote}"
              </p>
            )}
          </div>

          <div class="pt-3 border-t border-amber-900/50 flex items-center justify-between text-[11px] font-sans text-amber-400/80 group-hover:text-amber-200">
            <span>Chi tiết &amp; Ghi chú</span>
            <span class="text-amber-400 group-hover:translate-x-1 transition-transform">Xem →</span>
          </div>
        </article>
      ))}
    </section>

    <!-- Empty state -->
    <div id="no-results" class="hidden text-center py-20 bg-[#160e09] rounded-3xl border border-amber-900/50 mt-6 font-serif shadow-2xl">
      <p class="text-xl font-bold text-amber-200 mb-1">Không tìm thấy cuốn sách nào</p>
      <p class="text-xs text-amber-400/70 font-sans">Thử bỏ các tiêu chí lọc hoặc gõ từ khóa tìm kiếm khác.</p>
    </div>

    <!-- Goodreads Footer Sync Notice -->
    <footer class="mt-20 pt-8 border-t border-amber-900/40 text-center font-sans text-xs text-amber-400/70">
      <p>
        Data &amp; Image Source: The reading list and reviews on this page are continuously synced from my <a href={SITE.links.goodreads} target="_blank" rel="noopener noreferrer" class="text-amber-200 font-bold underline hover:text-amber-400">Goodreads Profile (@vietdoo)</a> &amp; Open Library API.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .cat-btn.active, .status-btn.active, .view-btn.active {
    background-color: #78350f !important;
    color: #fef3c7 !important;
    border-color: #d97706 !important;
    box-shadow: 0 4px 12px rgba(120, 53, 15, 0.6);
  }
</style>

<script is:inline define:vars={{ booksData }}>
  (function initBookshelf() {
    let currentCat = 'all';
    let currentStatus = 'all';
    let searchQuery = '';
    let currentView = 'shelf';

    const cards = document.querySelectorAll('.book-card');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-results');
    const searchInput = document.getElementById('search-input');
    const shelfContainer = document.getElementById('shelf-view-container');
    const gridContainer = document.getElementById('grid-view-container');

    // View Switcher (Shelf vs Grid)
    document.querySelectorAll('#view-mode-toggle .view-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#view-mode-toggle .view-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentView = btn.dataset.view;

        if (currentView === 'shelf') {
          shelfContainer.classList.remove('hidden');
          gridContainer.classList.add('hidden');
        } else {
          shelfContainer.classList.add('hidden');
          gridContainer.classList.remove('hidden');
        }
      });
    });

    // Filter Logic
    function filterBooks() {
      let count = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category;
        const status = card.dataset.status;
        const title = card.dataset.title;
        const author = card.dataset.author;
        const tags = card.dataset.tags;

        const matchCat = currentCat === 'all' || cat === currentCat;
        const matchStatus = currentStatus === 'all' || status === currentStatus;
        const matchSearch =
          !searchQuery ||
          title.includes(searchQuery) ||
          author.includes(searchQuery) ||
          tags.includes(searchQuery);

        if (matchCat && matchStatus && matchSearch) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      ['reading', 'completed', 'want'].forEach((groupKey) => {
        const groupEl = document.getElementById(`shelf-group-${groupKey}`);
        if (groupEl) {
          const visibleInGroup = groupEl.querySelectorAll('.book-card:not(.hidden)').length;
          if (visibleInGroup === 0) groupEl.classList.add('hidden');
          else groupEl.classList.remove('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = count;
      if (noResultsEl) {
        if (count === 0) noResultsEl.classList.remove('hidden');
        else noResultsEl.classList.add('hidden');
      }
    }

    // Category Tabs
    document.querySelectorAll('#category-filters .cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#category-filters .cat-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.dataset.cat;
        filterBooks();
      });
    });

    // Status Tabs
    document.querySelectorAll('#status-filters .status-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#status-filters .status-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentStatus = btn.dataset.status;
        filterBooks();
      });
    });

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterBooks();
      });
    }

    // Modal Logic
    const modal = document.getElementById('book-modal');
    const modalContent = document.getElementById('modal-content');
    const modalClose = document.getElementById('modal-close');

    function openModal(book) {
      if (!modal || !book) return;

      document.getElementById('modal-cover').src = book.coverImage;
      document.getElementById('modal-cover').alt = book.title;
      document.getElementById('modal-title').textContent = book.title;
      document.getElementById('modal-subtitle').textContent = book.subtitle || '';
      document.getElementById('modal-author').textContent = `Tác giả: ${book.author}`;
      document.getElementById('modal-category').textContent = book.categoryLabel;

      const statusEl = document.getElementById('modal-status');
      statusEl.textContent = book.statusLabel;
      if (book.status === 'reading') {
        statusEl.className = 'px-3 py-1 text-[11px] font-bold rounded-md bg-blue-950/90 text-blue-300 border border-blue-700/50 font-sans uppercase tracking-wider';
      } else if (book.status === 'completed') {
        statusEl.className = 'px-3 py-1 text-[11px] font-bold rounded-md bg-emerald-950/90 text-emerald-300 border border-emerald-700/50 font-sans uppercase tracking-wider';
      } else {
        statusEl.className = 'px-3 py-1 text-[11px] font-bold rounded-md bg-amber-950/90 text-amber-300 border border-amber-700/50 font-sans uppercase tracking-wider';
      }

      const ratingContainer = document.getElementById('modal-rating-container');
      const progressContainer = document.getElementById('modal-progress-container');

      if (book.rating) {
        ratingContainer.classList.remove('hidden');
        document.getElementById('modal-rating-stars').textContent = '★'.repeat(Math.floor(book.rating));
        document.getElementById('modal-rating-val').textContent = `${book.rating.toFixed(1)} / 5.0`;
      } else {
        ratingContainer.classList.add('hidden');
      }

      if (book.status === 'reading' && book.progress) {
        progressContainer.classList.remove('hidden');
        document.getElementById('modal-progress-val').textContent = `${book.progress}%`;
        document.getElementById('modal-progress-bar').style.width = `${book.progress}%`;
        document.getElementById('modal-chapter').textContent = book.currentChapter || '';
      } else {
        progressContainer.classList.add('hidden');
      }

      document.getElementById('modal-pages').textContent = book.pages ? `📄 ${book.pages} trang` : '';
      document.getElementById('modal-year').textContent = book.yearRead ? `📅 Đọc năm ${book.yearRead}` : '';
      document.getElementById('modal-summary').textContent = book.summary;
      document.getElementById('modal-review').textContent = book.review;

      const quoteBox = document.getElementById('modal-quote-box');
      if (book.quote) {
        quoteBox.classList.remove('hidden');
        document.getElementById('modal-quote').textContent = `"${book.quote}"`;
      } else {
        quoteBox.classList.add('hidden');
      }

      const takeawaysEl = document.getElementById('modal-takeaways');
      takeawaysEl.innerHTML = '';
      if (book.keyTakeaways && book.keyTakeaways.length > 0) {
        book.keyTakeaways.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2.5 text-xs leading-relaxed bg-amber-950/40 p-3 rounded-xl border border-amber-900/40';
          li.innerHTML = `<span class="text-amber-400 font-bold text-sm font-serif">✒️</span> <span>${t}</span>`;
          takeawaysEl.appendChild(li);
        });
      }

      const tagsEl = document.getElementById('modal-tags');
      tagsEl.innerHTML = '';
      if (book.tags) {
        book.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'px-2.5 py-0.5 text-[10px] font-bold rounded-md bg-amber-950 text-amber-300 border border-amber-800/50 uppercase';
          span.textContent = `#${tag}`;
          tagsEl.appendChild(span);
        });
      }

      const grLinkEl = document.getElementById('modal-goodreads-link');
      if (grLinkEl) {
        grLinkEl.href = book.goodreadsUrl || 'https://www.goodreads.com/vietdoo';
      }

      const linkEl = document.getElementById('modal-link');
      if (book.link) {
        linkEl.href = book.link;
        linkEl.classList.remove('hidden');
      } else {
        linkEl.classList.add('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalContent.classList.add('scale-95');
      modalContent.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const book = booksData.find((b) => b.id === id);
        if (book) openModal(book);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>
