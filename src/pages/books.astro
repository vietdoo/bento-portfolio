---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { getLiveGoodreadsBooks, type GoodreadsBook } from "../lib/goodreads";

const booksData: GoodreadsBook[] = await getLiveGoodreadsBooks();

// Extract years present in Goodreads RSS dynamically
const rawYears = Array.from(new Set(booksData.map((b) => b.yearRead || "2023"))).sort((a, b) => parseInt(b, 10) - parseInt(a, 10));
const defaultYearList = ["2026", "2025", "2024", "2023"];
const years = Array.from(new Set([...rawYears, ...defaultYearList])).sort((a, b) => parseInt(b, 10) - parseInt(a, 10));

const booksByYear: Record<string, GoodreadsBook[]> = {};
years.forEach((yr) => {
  booksByYear[yr] = booksData.filter((b) => b.yearRead === yr);
});

// Calculate yearly counts strictly from Goodreads
const yearlyCounts: Record<string, number> = {};
years.forEach((yr) => {
  yearlyCounts[yr] = booksByYear[yr].length;
});

const maxYearlyCount = Math.max(...Object.values(yearlyCounts), 1);

// Monthly stats for active year (or most recent year with books)
const monthLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const activeYear = years.find((yr) => (booksByYear[yr] || []).length > 0) || "2023";
const monthlyCountsActiveYear = Array.from({ length: 12 }, (_, i) => {
  return (booksByYear[activeYear] || []).filter((b) => b.monthRead === i + 1).length;
});
const maxMonthlyCount = Math.max(...monthlyCountsActiveYear, 1);
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullName} - Bookshelf`}
  description="Personal reading log & bookshelf."
>
  <!-- Detail Modal (Ultra Minimal & Modern) -->
  <div
    id="book-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 p-4 sm:p-6"
    aria-hidden="true"
  >
    <div
      class="bg-zinc-900/95 border border-white/10 rounded-3xl max-w-xl w-full max-h-[85vh] overflow-y-auto p-6 sm:p-7 shadow-2xl relative text-white transform scale-95 transition-all duration-300"
      id="modal-content"
    >
      <button
        id="modal-close"
        class="absolute top-5 right-5 text-zinc-400 hover:text-white transition-colors bg-white/5 hover:bg-white/10 border border-white/10 rounded-full w-8 h-8 flex items-center justify-center text-sm font-semibold z-10"
        aria-label="Close modal"
      >
        ✕
      </button>

      <div class="flex flex-col sm:flex-row gap-5 mb-5 pb-5 border-b border-white/10">
        <div class="w-28 h-40 sm:w-32 sm:h-48 rounded-xl overflow-hidden shadow-2xl border border-white/10 bg-zinc-800 flex-shrink-0 mx-auto sm:mx-0">
          <img id="modal-cover" src="" alt="" class="w-full h-full object-cover" />
        </div>

        <div class="flex-1 flex flex-col justify-between text-left">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span id="modal-category" class="px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-white/10 text-zinc-300 border border-white/10"></span>
              <span id="modal-status" class="px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full"></span>
            </div>
            <h2 id="modal-title" class="text-lg sm:text-xl font-bold tracking-tight text-white mb-1"></h2>
            <p id="modal-subtitle" class="text-xs text-zinc-400 italic mb-2"></p>
            <p id="modal-author" class="text-xs font-mono text-zinc-400"></p>
          </div>

          <div class="space-y-1.5 pt-2 text-xs font-mono text-zinc-300">
            <div id="modal-rating-container" class="flex items-center gap-1.5">
              <span class="text-zinc-200 font-bold" id="modal-rating-stars"></span>
              <span id="modal-rating-val" class="text-zinc-300 text-[11px]"></span>
            </div>
            <div id="modal-progress-container" class="space-y-1 hidden">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-zinc-400">Progress:</span>
                <span id="modal-progress-val" class="text-white font-bold"></span>
              </div>
              <div class="w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden border border-white/10">
                <div id="modal-progress-bar" class="h-full bg-white transition-all duration-500 rounded-full"></div>
              </div>
              <p id="modal-chapter" class="text-[11px] text-zinc-400 mt-0.5"></p>
            </div>
            <div class="flex flex-wrap gap-3 text-zinc-400 text-[11px] pt-1">
              <span id="modal-pages"></span>
              <span id="modal-year"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-4 text-xs sm:text-sm">
        <div>
          <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-zinc-400 mb-1.5">SUMMARY</h3>
          <p id="modal-summary" class="text-zinc-200 leading-relaxed bg-white/[0.03] p-3.5 rounded-xl border border-white/5 text-xs font-sans"></p>
        </div>

        <div>
          <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-zinc-400 mb-1.5">REVIEW &amp; NOTES</h3>
          <p id="modal-review" class="text-zinc-300 leading-relaxed text-xs font-sans"></p>
        </div>

        <div id="modal-quote-box" class="bg-white/5 border-l-2 border-white/40 p-3.5 rounded-r-xl my-2">
          <p id="modal-quote" class="text-zinc-200 italic text-xs leading-relaxed font-sans"></p>
        </div>

        <div>
          <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-zinc-400 mb-1.5">KEY TAKEAWAYS</h3>
          <ul id="modal-takeaways" class="space-y-1.5 list-none p-0 m-0 text-zinc-300 text-xs font-sans"></ul>
        </div>

        <div class="pt-4 border-t border-white/10 flex flex-wrap justify-between items-center gap-3">
          <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
          <div>
            <a
              id="modal-goodreads-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-xl bg-white text-black hover:bg-zinc-200 transition-colors shadow-md"
            >
              Goodreads ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 text-white">
    <BackLink href="/" class="mb-8" />

    <!-- Clean Header -->
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight mb-1">Bookshelf</h1>
      <p class="text-darkslate-300 text-xs sm:text-sm">Personal reading log &amp; bookshelf.</p>
    </header>

    <!-- SECTION 1: ANALYTICS CHARTS (Minimalist White & Gray Theme) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
      <!-- Card 1: BOOKS PER YEAR -->
      <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-2xl p-5 flex flex-col justify-between h-56">
        <h3 class="text-xs font-bold tracking-widest text-darkslate-300 uppercase">BOOKS PER YEAR</h3>

        <div class="flex items-end justify-around h-36 pt-4 px-2">
          {years.slice(0, 4).map((yr) => {
            const count = yearlyCounts[yr] || 0;
            const barHeightPx = count > 0 ? Math.max(16, Math.round((count / maxYearlyCount) * 85)) : 8;
            return (
              <div class="flex flex-col items-center gap-1 flex-1 group">
                <span class="text-[11px] font-mono text-zinc-200 font-bold opacity-90 group-hover:opacity-100">{count}</span>
                <div class="h-24 w-full flex items-end justify-center">
                  <div 
                    class={`w-10 sm:w-12 rounded-t-md transition-all duration-300 ${
                      count > 0 
                        ? "bg-gradient-to-t from-zinc-400 via-neutral-200 to-white group-hover:brightness-110 shadow-[0_0_12px_rgba(255,255,255,0.25)]" 
                        : "bg-darkslate-400/20"
                    }`} 
                    style={`height: ${barHeightPx}px;`}
                  ></div>
                </div>
                <span class="text-[11px] font-mono text-darkslate-300 mt-1">{yr}</span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Card 2: MONTHLY ACTIVITY -->
      <div class="bg-darkslate-500/50 border border-darkslate-400/60 rounded-2xl p-5 flex flex-col justify-between h-56">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold tracking-widest text-darkslate-300 uppercase">MONTHLY</h3>
          <div class="flex bg-darkslate-700/60 p-0.5 rounded-lg border border-darkslate-400/40 text-[10px] font-mono">
            <span class="px-2 py-0.5 rounded bg-white text-black font-bold">{activeYear}</span>
            <span class="px-2 py-0.5 rounded text-darkslate-300">All</span>
          </div>
        </div>

        <div class="flex items-end justify-between h-36 pt-4 px-1 gap-1">
          {monthLabels.map((m, idx) => {
            const count = monthlyCountsActiveYear[idx];
            const barHeightPx = count > 0 ? Math.max(20, Math.round((count / maxMonthlyCount) * 85)) : 6;
            return (
              <div class="flex flex-col items-center gap-1 flex-1 group">
                <div class="h-24 w-full flex items-end justify-center">
                  <div 
                    class={`w-full max-w-[14px] rounded-t-xs transition-all duration-300 ${
                      count > 0 
                        ? "bg-gradient-to-t from-zinc-400 via-neutral-200 to-white shadow-[0_0_8px_rgba(255,255,255,0.3)]" 
                        : "bg-darkslate-400/20"
                    }`} 
                    style={`height: ${barHeightPx}px;`}
                  ></div>
                </div>
                <span class="text-[9px] font-mono text-darkslate-300 mt-1">{m}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECTION 2: YEAR-GROUPED READING TIMELINE -->
    <section class="space-y-12">
      {years.map((year) => {
        const yearBooks = booksByYear[year];
        if (!yearBooks || yearBooks.length === 0) return null;

        return (
          <div class="space-y-4">
            <!-- Year Header Divider -->
            <div class="flex items-center gap-4">
              <h2 class="text-xl font-bold text-white tracking-tight">{year}</h2>
              <div class="flex-1 h-[1px] bg-darkslate-400/40"></div>
              <span class="text-xs font-mono text-darkslate-300">{yearBooks.length} books</span>
            </div>

            <!-- Horizontal Book Cards Grid (2 columns per row) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {yearBooks.map((book) => (
                <article
                  class="book-card group bg-darkslate-500/40 hover:bg-darkslate-500/70 border border-darkslate-400/60 hover:border-white/40 rounded-2xl p-4 flex gap-4 items-center transition-all duration-300 cursor-pointer shadow-sm relative overflow-hidden"
                  data-id={book.id}
                >
                  <!-- Book Cover Image Left -->
                  <div class="w-20 sm:w-24 aspect-[2/3] rounded-lg overflow-hidden flex-shrink-0 bg-darkslate-800 border border-white/10 shadow-md">
                    <img 
                      src={book.coverImage} 
                      alt={book.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                      loading="lazy" 
                    />
                  </div>

                  <!-- Book Content Right -->
                  <div class="flex-1 min-w-0 flex flex-col justify-between h-32 py-0.5">
                    <div>
                      <h3 class="text-sm font-bold text-white tracking-tight line-clamp-1 group-hover:text-zinc-200 transition-colors">
                        {book.title}
                      </h3>
                      <p class="text-xs text-darkslate-300 font-medium truncate mt-0.5">
                        {book.author}
                      </p>

                      <!-- Star Rating & Goodreads sentiment string (Clean text, no icons) -->
                      <div class="flex items-center gap-1.5 mt-2 text-xs">
                        {book.rating ? (
                          <>
                            <span class="text-zinc-200 font-bold tracking-tighter">
                              {"★".repeat(Math.floor(book.rating))}
                            </span>
                            <span class="text-[11px] font-mono text-darkslate-300">
                              {book.ratingText || "it was amazing"}
                            </span>
                          </>
                        ) : (
                          <span class="text-[11px] font-mono text-zinc-300 font-medium">
                            {book.statusLabel}
                          </span>
                        )}
                      </div>
                    </div>

                    <!-- Bottom Metadata Row: Pages & Read Date -->
                    <div class="flex items-center justify-between text-[11px] font-mono text-darkslate-300 pt-2 border-t border-white/5">
                      <span>Pages: {book.pages || "—"}</span>
                      <span>Read: {book.dateRead || book.yearRead}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ booksData }}>
  (function initBookshelf() {
    const cards = document.querySelectorAll('.book-card');
    const modal = document.getElementById('book-modal');
    const modalContent = document.getElementById('modal-content');
    const modalClose = document.getElementById('modal-close');

    function openModal(book) {
      if (!modal || !book) return;

      document.getElementById('modal-cover').src = book.coverImage;
      document.getElementById('modal-cover').alt = book.title;
      document.getElementById('modal-title').textContent = book.title;
      document.getElementById('modal-subtitle').textContent = book.subtitle || '';
      document.getElementById('modal-author').textContent = `By ${book.author}`;
      document.getElementById('modal-category').textContent = book.categoryLabel;

      const statusEl = document.getElementById('modal-status');
      statusEl.textContent = book.statusLabel;
      if (book.status === 'reading') {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-white/10 text-sky-300 border border-sky-500/30';
      } else if (book.status === 'completed') {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-white/10 text-emerald-300 border border-emerald-500/30';
      } else {
        statusEl.className = 'px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-white/10 text-zinc-300 border border-white/15';
      }

      const ratingContainer = document.getElementById('modal-rating-container');
      const progressContainer = document.getElementById('modal-progress-container');

      if (book.rating) {
        ratingContainer.classList.remove('hidden');
        document.getElementById('modal-rating-stars').textContent = '★'.repeat(Math.floor(book.rating));
        document.getElementById('modal-rating-val').textContent = `${book.rating.toFixed(1)} / 5.0 (${book.ratingText || 'it was amazing'})`;
      } else {
        ratingContainer.classList.add('hidden');
      }

      if (book.status === 'reading' && book.progress) {
        progressContainer.classList.remove('hidden');
        document.getElementById('modal-progress-val').textContent = `${book.progress}%`;
        document.getElementById('modal-progress-bar').style.width = `${book.progress}%`;
        document.getElementById('modal-chapter').textContent = book.currentChapter || '';
      } else {
        progressContainer.classList.add('hidden');
      }

      document.getElementById('modal-pages').textContent = book.pages ? `${book.pages} pages` : '';
      document.getElementById('modal-year').textContent = book.dateRead ? `${book.dateRead}` : `Read in ${book.yearRead}`;
      document.getElementById('modal-summary').textContent = book.summary;
      document.getElementById('modal-review').textContent = book.review;

      const quoteBox = document.getElementById('modal-quote-box');
      if (book.quote) {
        quoteBox.classList.remove('hidden');
        document.getElementById('modal-quote').textContent = `"${book.quote}"`;
      } else {
        quoteBox.classList.add('hidden');
      }

      const takeawaysEl = document.getElementById('modal-takeaways');
      takeawaysEl.innerHTML = '';
      if (book.keyTakeaways && book.keyTakeaways.length > 0) {
        book.keyTakeaways.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 text-xs leading-relaxed bg-white/[0.03] p-2.5 rounded-lg border border-white/5';
          li.innerHTML = `<span class="text-zinc-400 font-bold text-xs">•</span> <span>${t}</span>`;
          takeawaysEl.appendChild(li);
        });
      }

      const tagsEl = document.getElementById('modal-tags');
      tagsEl.innerHTML = '';
      if (book.tags) {
        book.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'px-2.5 py-0.5 text-[10px] font-mono rounded-md bg-white/5 text-zinc-400 border border-white/10';
          span.textContent = `#${tag}`;
          tagsEl.appendChild(span);
        });
      }

      const grLinkEl = document.getElementById('modal-goodreads-link');
      if (grLinkEl) {
        grLinkEl.href = book.goodreadsUrl || 'https://www.goodreads.com/user/show/165632513';
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalContent.classList.add('scale-95');
      modalContent.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const book = booksData.find((b) => b.id === id);
        if (book) openModal(book);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>
