---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { booksData, type Book } from "../data/books";

const readingCount = booksData.filter((b) => b.status === "reading").length;
const completedCount = booksData.filter((b) => b.status === "completed").length;
const wantToReadCount = booksData.filter((b) => b.status === "want-to-read").length;
const avgRating = (
  booksData
    .filter((b) => b.rating)
    .reduce((acc, b) => acc + (b.rating || 0), 0) /
  booksData.filter((b) => b.rating).length
).toFixed(1);
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullName} - Bookshelf & Reading List`}
  description="Bộ sưu tập sách kỹ thuật IT, kiến trúc hệ thống và phát triển bản thân tôi đã đọc, đang đọc và dự định đọc."
>
  <!-- Modal Lightbox / Detail View -->
  <div
    id="book-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 p-4 sm:p-6"
    aria-hidden="true"
  >
    <div
      class="bg-darkslate-600/90 border border-darkslate-400 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-2xl relative text-white transform scale-95 transition-all duration-300"
      id="modal-content"
    >
      <button
        id="modal-close"
        class="absolute top-4 right-4 text-darkslate-300 hover:text-white transition-colors bg-darkslate-700/80 hover:bg-darkslate-500 border border-darkslate-400 rounded-full w-9 h-9 flex items-center justify-center text-sm font-bold z-10"
        aria-label="Close modal"
      >
        ✕
      </button>

      <div class="flex flex-col sm:flex-row gap-6 mb-6">
        <div class="w-36 h-52 sm:w-44 sm:h-64 rounded-xl overflow-hidden shadow-2xl flex-shrink-0 border border-white/10 bg-darkslate-800 mx-auto sm:mx-0">
          <img id="modal-cover" src="" alt="" class="w-full h-full object-cover" />
        </div>
        <div class="flex-1 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span id="modal-category" class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary-500/20 text-primary-400 border border-primary-500/30"></span>
              <span id="modal-status" class="px-2.5 py-0.5 text-xs font-semibold rounded-full"></span>
            </div>
            <h2 id="modal-title" class="text-2xl font-bold tracking-tight text-white mb-1"></h2>
            <p id="modal-subtitle" class="text-xs text-darkslate-300 mb-3 italic"></p>
            <p id="modal-author" class="text-sm font-semibold text-primary-400 mb-4"></p>
          </div>

          <div class="space-y-2 border-t border-white/10 pt-3 text-xs text-darkslate-200">
            <div id="modal-rating-container" class="flex items-center gap-1.5">
              <span class="text-amber-400 font-bold" id="modal-rating-stars"></span>
              <span id="modal-rating-val" class="font-semibold text-white"></span>
            </div>
            <div id="modal-progress-container" class="space-y-1 hidden">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-darkslate-300">Tiến độ đọc:</span>
                <span id="modal-progress-val" class="text-primary-400 font-bold"></span>
              </div>
              <div class="w-full h-2 bg-darkslate-800 rounded-full overflow-hidden border border-white/10">
                <div id="modal-progress-bar" class="h-full bg-primary-500 transition-all duration-500 rounded-full"></div>
              </div>
              <p id="modal-chapter" class="text-[11px] text-darkslate-300 mt-0.5"></p>
            </div>
            <div class="flex flex-wrap gap-4 text-darkslate-300 text-[12px] pt-1">
              <span id="modal-pages"></span>
              <span id="modal-year"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Detail sections -->
      <div class="space-y-5 text-sm">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-darkslate-300 mb-1.5">Tóm Tắt Nhanh</h3>
          <p id="modal-summary" class="text-darkslate-100 leading-relaxed bg-darkslate-700/50 p-3.5 rounded-xl border border-white/5"></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-darkslate-300 mb-1.5">Đánh Giá &amp; Ghi Chú</h3>
          <p id="modal-review" class="text-darkslate-200 leading-relaxed"></p>
        </div>

        <div id="modal-quote-box" class="bg-primary-950/40 border-l-4 border-primary-500 p-4 rounded-r-xl my-4">
          <p id="modal-quote" class="text-primary-200 italic font-serif text-sm leading-relaxed"></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-darkslate-300 mb-2">Bài Học Rút Ra (Key Takeaways)</h3>
          <ul id="modal-takeaways" class="space-y-2 list-none p-0 m-0 text-darkslate-200"></ul>
        </div>

        <div class="pt-4 border-t border-white/10 flex justify-between items-center">
          <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
          <a
            id="modal-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-primary-500 hover:bg-primary-600 text-white transition-colors shadow-lg"
          >
            Trang Chủ / Goodreads ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <main class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-10 text-white">
    <BackLink href="/" class="mb-8" />

    <!-- Header Section -->
    <header class="mb-10 text-left">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-primary-500/20 text-primary-400 border border-primary-500/30">
          Reading List &amp; Library
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-3">
        My Bookshelf 📚
      </h1>
      <p class="text-darkslate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        Không gian lưu trữ những cuốn sách mình đã đọc, đang đọc và lên kế hoạch đọc. Bao gồm tài liệu kỹ thuật IT, kiến trúc hệ thống phân tán và sách phát triển bản thân.
      </p>

      <!-- Stats Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
        <div class="bg-darkslate-500/60 border border-darkslate-400 rounded-xl p-3.5 flex flex-col justify-between">
          <span class="text-xs text-darkslate-300 font-medium">Đang đọc 📖</span>
          <span class="text-2xl font-bold text-primary-400 mt-1">{readingCount} <span class="text-xs font-normal text-darkslate-300">cuốn</span></span>
        </div>
        <div class="bg-darkslate-500/60 border border-darkslate-400 rounded-xl p-3.5 flex flex-col justify-between">
          <span class="text-xs text-darkslate-300 font-medium">Đã hoàn thành ✅</span>
          <span class="text-2xl font-bold text-emerald-400 mt-1">{completedCount} <span class="text-xs font-normal text-darkslate-300">cuốn</span></span>
        </div>
        <div class="bg-darkslate-500/60 border border-darkslate-400 rounded-xl p-3.5 flex flex-col justify-between">
          <span class="text-xs text-darkslate-300 font-medium">Dự định đọc 📌</span>
          <span class="text-2xl font-bold text-amber-400 mt-1">{wantToReadCount} <span class="text-xs font-normal text-darkslate-300">cuốn</span></span>
        </div>
        <div class="bg-darkslate-500/60 border border-darkslate-400 rounded-xl p-3.5 flex flex-col justify-between">
          <span class="text-xs text-darkslate-300 font-medium">Đánh giá trung bình ⭐</span>
          <span class="text-2xl font-bold text-amber-300 mt-1">{avgRating} <span class="text-xs font-normal text-darkslate-300">/ 5.0</span></span>
        </div>
      </div>
    </header>

    <!-- Controls Filter & Search Bar -->
    <section class="bg-darkslate-500/80 border border-darkslate-400 rounded-2xl p-4 sm:p-5 mb-8 shadow-xl">
      <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center">
        <!-- Search Input -->
        <div class="relative flex-1">
          <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-darkslate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Tìm theo tên sách, tác giả, từ khóa..."
            class="w-full pl-10 pr-4 py-2.5 bg-darkslate-700/80 border border-darkslate-400 focus:border-primary-500 rounded-xl text-xs sm:text-sm text-white placeholder-darkslate-300 outline-none transition-colors"
          />
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Category Filter -->
          <div class="flex bg-darkslate-700/60 p-1 rounded-xl border border-darkslate-400/60" id="category-filters">
            <button data-cat="all" class="cat-btn active px-3 py-1.5 rounded-lg text-xs font-semibold transition-all">Tất cả</button>
            <button data-cat="tech" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-darkslate-300 hover:text-white transition-all">💻 Tech IT</button>
            <button data-cat="selfhelp" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-darkslate-300 hover:text-white transition-all">💡 Self-Help</button>
          </div>

          <!-- Status Filter -->
          <div class="flex bg-darkslate-700/60 p-1 rounded-xl border border-darkslate-400/60" id="status-filters">
            <button data-status="all" class="status-btn active px-3 py-1.5 rounded-lg text-xs font-semibold transition-all">Tất cả trạng thái</button>
            <button data-status="reading" class="status-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-darkslate-300 hover:text-white transition-all">📖 Đang đọc</button>
            <button data-status="completed" class="status-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-darkslate-300 hover:text-white transition-all">✅ Đã đọc</button>
            <button data-status="want-to-read" class="status-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-darkslate-300 hover:text-white transition-all">📌 Dự định</button>
          </div>
        </div>
      </div>

      <!-- Counter feedback -->
      <div class="mt-3 text-xs text-darkslate-300 flex justify-between items-center pt-2 border-t border-white/5">
        <span>Hiển thị <b id="visible-count" class="text-white">{booksData.length}</b> / {booksData.length} cuốn sách</span>
        <span class="text-[11px] text-darkslate-300 hidden sm:inline">💡 Bấm vào bất kỳ thẻ sách nào để xem đánh giá &amp; ghi chép chi tiết</span>
      </div>
    </section>

    <!-- Books Grid -->
    <section id="books-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {
        booksData.map((book) => (
          <article
            class="book-card group bg-darkslate-500/80 border border-darkslate-400 hover:border-primary-500 rounded-2xl p-4 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl cursor-pointer relative overflow-hidden"
            data-id={book.id}
            data-category={book.category}
            data-status={book.status}
            data-title={book.title.toLowerCase()}
            data-author={book.author.toLowerCase()}
            data-tags={book.tags.join(" ").toLowerCase()}
          >
            <div>
              <!-- Cover Container with 3D shadow effect -->
              <div class="relative w-full aspect-[2/3] rounded-xl overflow-hidden mb-4 shadow-xl border border-white/10 bg-darkslate-700 group-hover:shadow-primary-500/20 transition-all duration-300">
                <img
                  src={book.coverImage}
                  alt={book.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />

                <!-- Category Badge top left -->
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 text-[10px] font-bold rounded-md bg-black/70 backdrop-blur-md text-white border border-white/10 uppercase tracking-wider">
                  {book.category === "tech" ? "Tech IT" : "Self-Help"}
                </span>

                <!-- Status Badge top right -->
                <span
                  class={`absolute top-2.5 right-2.5 px-2.5 py-0.5 text-[10px] font-bold rounded-full backdrop-blur-md border shadow-md flex items-center gap-1 ${
                    book.status === "reading"
                      ? "bg-primary-950/80 text-primary-400 border-primary-500/50"
                      : book.status === "completed"
                      ? "bg-emerald-950/80 text-emerald-400 border-emerald-500/50"
                      : "bg-amber-950/80 text-amber-400 border-amber-500/50"
                  }`}
                >
                  {book.status === "reading" && <span class="w-1.5 h-1.5 rounded-full bg-primary-400 animate-pulse"></span>}
                  {book.statusLabel}
                </span>
              </div>

              <!-- Book Info -->
              <h3 class="text-base font-bold text-white tracking-tight leading-snug group-hover:text-primary-400 transition-colors line-clamp-2 mb-1">
                {book.title}
              </h3>
              <p class="text-xs font-medium text-darkslate-300 mb-3">{book.author}</p>

              <!-- Progress bar (for reading) or Rating (for completed) -->
              {book.status === "reading" && book.progress && (
                <div class="bg-darkslate-700/60 border border-white/5 rounded-xl p-2.5 mb-3">
                  <div class="flex justify-between text-[11px] font-semibold mb-1">
                    <span class="text-primary-400">Tiến độ</span>
                    <span class="text-white">{book.progress}%</span>
                  </div>
                  <div class="w-full h-1.5 bg-darkslate-800 rounded-full overflow-hidden">
                    <div class="h-full bg-primary-500 rounded-full" style={`width: ${book.progress}%`}></div>
                  </div>
                  {book.currentChapter && (
                    <p class="text-[10px] text-darkslate-300 mt-1 line-clamp-1 truncate">{book.currentChapter}</p>
                  )}
                </div>
              )}

              {book.status === "completed" && book.rating && (
                <div class="flex items-center gap-1 mb-3 text-xs">
                  <span class="text-amber-400 font-bold">★ {book.rating.toFixed(1)}</span>
                  <span class="text-darkslate-300 text-[11px]">/ 5.0</span>
                </div>
              )}

              <!-- Quote preview -->
              {book.quote && (
                <p class="text-[11px] text-darkslate-300 italic line-clamp-2 mb-3 bg-darkslate-700/30 p-2 rounded-lg border border-white/5">
                  "{book.quote}"
                </p>
              )}
            </div>

            <!-- Footer Action -->
            <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-darkslate-300 font-semibold group-hover:text-white transition-colors">
              <span>Ghi chú &amp; Đánh giá</span>
              <span class="text-primary-400 group-hover:translate-x-1 transition-transform duration-200">Chi tiết →</span>
            </div>
          </article>
        ))
      }
    </section>

    <!-- Empty state -->
    <div id="no-results" class="hidden text-center py-20 bg-darkslate-500/40 rounded-2xl border border-darkslate-400 mt-6">
      <p class="text-lg font-bold text-white mb-1">Không tìm thấy sách phù hợp</p>
      <p class="text-xs text-darkslate-300">Thử thay đổi từ khóa tìm kiếm hoặc bỏ chọn các bộ lọc status/category.</p>
    </div>
  </main>
</Layout>

<style>
  .cat-btn.active, .status-btn.active {
    background-color: var(--primary-500) !important;
    color: #ffffff !important;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--primary-500) 40%, transparent);
  }
</style>

<script is:inline define:vars={{ booksData }}>
  (function initBookshelf() {
    let currentCat = 'all';
    let currentStatus = 'all';
    let searchQuery = '';

    const grid = document.getElementById('books-grid');
    const cards = document.querySelectorAll('.book-card');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-results');
    const searchInput = document.getElementById('search-input');

    // Filter Logic
    function filterBooks() {
      let count = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category;
        const status = card.dataset.status;
        const title = card.dataset.title;
        const author = card.dataset.author;
        const tags = card.dataset.tags;

        const matchCat = currentCat === 'all' || cat === currentCat;
        const matchStatus = currentStatus === 'all' || status === currentStatus;
        const matchSearch =
          !searchQuery ||
          title.includes(searchQuery) ||
          author.includes(searchQuery) ||
          tags.includes(searchQuery);

        if (matchCat && matchStatus && matchSearch) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = count;
      if (noResultsEl) {
        if (count === 0) noResultsEl.classList.remove('hidden');
        else noResultsEl.classList.add('hidden');
      }
    }

    // Category Tabs
    document.querySelectorAll('#category-filters .cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#category-filters .cat-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.dataset.cat;
        filterBooks();
      });
    });

    // Status Tabs
    document.querySelectorAll('#status-filters .status-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#status-filters .status-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentStatus = btn.dataset.status;
        filterBooks();
      });
    });

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterBooks();
      });
    }

    // Modal Logic
    const modal = document.getElementById('book-modal');
    const modalContent = document.getElementById('modal-content');
    const modalClose = document.getElementById('modal-close');

    function openModal(book) {
      if (!modal || !book) return;

      document.getElementById('modal-cover').src = book.coverImage;
      document.getElementById('modal-cover').alt = book.title;
      document.getElementById('modal-title').textContent = book.title;
      document.getElementById('modal-subtitle').textContent = book.subtitle || '';
      document.getElementById('modal-author').textContent = book.author;
      document.getElementById('modal-category').textContent = book.categoryLabel;

      const statusEl = document.getElementById('modal-status');
      statusEl.textContent = book.statusLabel;
      if (book.status === 'reading') {
        statusEl.className = 'px-2.5 py-0.5 text-xs font-semibold rounded-full bg-primary-500/20 text-primary-400 border border-primary-500/40';
      } else if (book.status === 'completed') {
        statusEl.className = 'px-2.5 py-0.5 text-xs font-semibold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
      } else {
        statusEl.className = 'px-2.5 py-0.5 text-xs font-semibold rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40';
      }

      // Rating or Progress
      const ratingContainer = document.getElementById('modal-rating-container');
      const progressContainer = document.getElementById('modal-progress-container');

      if (book.rating) {
        ratingContainer.classList.remove('hidden');
        document.getElementById('modal-rating-stars').textContent = '★'.repeat(Math.floor(book.rating));
        document.getElementById('modal-rating-val').textContent = `${book.rating.toFixed(1)} / 5.0`;
      } else {
        ratingContainer.classList.add('hidden');
      }

      if (book.status === 'reading' && book.progress) {
        progressContainer.classList.remove('hidden');
        document.getElementById('modal-progress-val').textContent = `${book.progress}%`;
        document.getElementById('modal-progress-bar').style.width = `${book.progress}%`;
        document.getElementById('modal-chapter').textContent = book.currentChapter || '';
      } else {
        progressContainer.classList.add('hidden');
      }

      document.getElementById('modal-pages').textContent = book.pages ? `📄 ${book.pages} trang` : '';
      document.getElementById('modal-year').textContent = book.yearRead ? `📅 Đọc năm ${book.yearRead}` : '';
      document.getElementById('modal-summary').textContent = book.summary;
      document.getElementById('modal-review').textContent = book.review;

      const quoteBox = document.getElementById('modal-quote-box');
      if (book.quote) {
        quoteBox.classList.remove('hidden');
        document.getElementById('modal-quote').textContent = `"${book.quote}"`;
      } else {
        quoteBox.classList.add('hidden');
      }

      const takeawaysEl = document.getElementById('modal-takeaways');
      takeawaysEl.innerHTML = '';
      if (book.keyTakeaways && book.keyTakeaways.length > 0) {
        book.keyTakeaways.forEach((t) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 text-xs leading-relaxed bg-darkslate-700/40 p-2.5 rounded-lg border border-white/5';
          li.innerHTML = `<span class="text-primary-400 font-bold text-sm">✓</span> <span>${t}</span>`;
          takeawaysEl.appendChild(li);
        });
      }

      const tagsEl = document.getElementById('modal-tags');
      tagsEl.innerHTML = '';
      if (book.tags) {
        book.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'px-2 py-0.5 text-[10px] font-semibold rounded bg-darkslate-700 text-darkslate-300 border border-white/10';
          span.textContent = `#${tag}`;
          tagsEl.appendChild(span);
        });
      }

      const linkEl = document.getElementById('modal-link');
      if (book.link) {
        linkEl.href = book.link;
        linkEl.classList.remove('hidden');
      } else {
        linkEl.classList.add('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalContent.classList.add('scale-95');
      modalContent.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const book = booksData.find((b) => b.id === id);
        if (book) openModal(book);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>
