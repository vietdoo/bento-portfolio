---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import Globe from "../components/Globe";
import DesignWorksCard from "../components/DesignWorksCard.astro";
import PixelHeart from "../components/PixelHeart.astro";
import PlaygroundCard from "../components/PlaygroundCard.astro";
import GuestbookCard from "../components/GuestbookCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { SITE } from "../site-config";
---

<script>
  import { initHomeEntrance } from "../lib/home-entrance";
  initHomeEntrance();
</script>

<Layout
  description={`Portfolio of ${SITE.author.fullName} (${SITE.author.shortName}), Software Engineer @ VNPT Group based in ${SITE.location.countryName}, specializing in Big Data, Data Engineering, microservices, and high-throughput pipelines.`}
  title={`${SITE.author.fullName} (${SITE.author.shortName}) - ${SITE.author.jobTitle}`}
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-x-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-[max(100dvh,830px)] lg:grid-rows-8 lg:grid-cols-4 lg:gap-4"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <DesignWorksCard />
    <Now />
    <PlaygroundCard />
    <GuestbookCard />
    <BlogCard />
    <Card
      colSpan="md:col-span-1"
      href="travel"
      rowSpan="md:row-span-1"
      title="Countries I visited"
    >
      <div slot="background" class="absolute inset-0 -z-10">
        <div class="hidden md:block h-full w-full">
          <Globe client:visible />
        </div>
        <div class="block md:hidden h-full w-full">
          <Globe client:visible isStatic={true} />
        </div>
      </div>
      <span class="text-xs text-white/60"
        >{SITE.visitedCountries.length} {SITE.visitedCountries.length === 1 ? "country" : "countries"}</span
      >
    </Card>
    <Card
      colSpan="md:col-span-1"
      href="visit"
      rowSpan="md:row-span-1"
      title="Vietnam map"
    >
      <div slot="background" class="absolute inset-0 -z-10 bg-darkslate-800 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 opacity-30 bg-[radial-gradient(circle_at_center,_var(--primary-500)_0%,_transparent_70%)]" />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-primary-500/40 transform -rotate-12 group-hover:scale-110 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </div>
      <span class="text-xs text-white/60">
        {SITE.visitedProvinces.length} / 34 tỉnh thành
      </span>
    </Card>
    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div class="flex h-full items-center justify-center">
        <p class="text-[10px] whitespace-nowrap text-center">
          © {new Date().getFullYear()} · Crafted with <PixelHeart /> using <a
            class="text-primary-500"
            href="https://astro.build/"
            target="_blank">Astro</a
          > by Me.
        </p>
      </div>
    </Card>
  </main>
</Layout>
