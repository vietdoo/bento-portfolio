---
import { formatDate } from "../lib/helpers";
import BackLink from "../components/BackLink.astro";
import LangToggle from "../components/Blog/LangToggle.astro";
import BasicLayout from "./BasicLayout.astro";
import type { BlogLang } from "../lib/blog-lang";

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  minutesRead: string;
  url: string;
  lang?: BlogLang;
  enHref?: string | undefined;
  viHref?: string | undefined;
};

const {
  title,
  description,
  pubDate,
  minutesRead,
  url,
  lang = "en",
  enHref,
  viHref,
} = Astro.props;

const hasTranslation = Boolean(enHref && viHref);
---

<BasicLayout description={description} page="blog" slug={url} title={title}>
  <main class="mx-auto max-w-3xl w-full min-h-screen p-8 text-neutral-100">
    <div class="mb-8 flex items-center justify-between gap-4">
      <BackLink href="/blog" />
      {
        hasTranslation && (
          <LangToggle current={lang} enHref={enHref} viHref={viHref} />
        )
      }
    </div>
    <div class="my-10">
      <h1 class="text-5xl font-semibold">{title}</h1>
      <div class="flex justify-between pt-4 text-gray-500 text-sm">
        <p>{formatDate(pubDate)}</p>
        <p>{minutesRead}</p>
      </div>
    </div>
    <article class="prose prose-p:text-red-500 prose-slate prose-invert pb-16">
      <slot />
    </article>
  </main>
</BasicLayout>
