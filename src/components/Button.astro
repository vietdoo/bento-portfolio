---
interface Props {
  rounded?: boolean;
  class?: string;
}

const { rounded, class: className, ...props } = Astro.props;
---

<button
  {...props}
  class={`h-full w-fit text-sm sm:text-base md:text-xl max-h-[38px] sm:max-h-[44px] md:max-h-[50px] shadow-custom shadow-primary-500 active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-darkslate-50 px-3 py-1.5 sm:px-4 md:px-5 md:py-2 border border-primary-500 hover:text-primary-500 transition-colors duration-100 ease-in-out bg-darkslate-900 cursor-pointer ${
    rounded ? "rounded-full" : "rounded-lg"
  } ${className ?? ""}`}
>
  <slot />
</button>
