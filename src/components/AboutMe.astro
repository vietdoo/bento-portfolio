---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

const stack = [
  { label: "Apache Spark", category: "bigdata" },
  { label: "Apache Kafka", category: "bigdata" },
  { label: "Hadoop HDFS", category: "bigdata" },
  { label: "Python", category: "lang" },
  { label: "C++", category: "lang" },
  { label: "Spring Boot", category: "backend" },
  { label: "FastAPI", category: "backend" },
  { label: "Microservices", category: "backend" },
  { label: "Redis", category: "database" },
  { label: "SQL / NoSQL", category: "database" },
  { label: "Kubernetes", category: "devops" },
  { label: "Docker", category: "devops" },
  { label: "Linux", category: "devops" },
  { label: "TypeScript", category: "lang" },
  { label: "Next.js", category: "frontend" },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-3 md:gap-4">
    <p class="text-sm font-light leading-relaxed">
      Hi, I'm <b class="font-bold">{SITE.author.fullNameVi}</b> (<span class="text-primary-400 font-semibold">{SITE.author.shortName}</span>), a Software Engineer @ <b class="font-semibold">{SITE.author.companyVi}</b> ({SITE.author.company}) based in {SITE.location.locality}, {SITE.location.countryName}. Currently engineering <b class="font-semibold">{SITE.author.projectVi}</b> ({SITE.author.project}), building scalable backend systems, Big Data pipelines, and cloud-native microservices.
    </p>

    <div class="flex flex-col gap-2">
      <span
        class="text-[10px] uppercase tracking-widest text-darkslate-300 font-medium"
        >Stack & tools</span
      >
      <div class="flex flex-wrap gap-1.5">
        {
          stack.map(({ label }) => (
            <span class="text-[11px] px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150 cursor-default">
              {label}
            </span>
          ))
        }
      </div>
    </div>

    <p class="text-sm font-light">
      Architecting scalable data infrastructure by day, building modern web experiences and AI agent workflows by night. Obsessed with clean code, low latency, and problem-solving.
    </p>
  </div>
</Card>
