---
// CuteBugs.astro - Cute interactive bugs crawling and hiding in the Welcome Card
---

<div id="bugs-container" class="absolute inset-0 z-0 pointer-events-auto overflow-hidden select-none">
  <canvas id="bugs-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  interface Bug {
    id: number;
    species: 'ladybug' | 'emerald' | 'firefly' | 'pinkberry';
    x: number;
    y: number;
    targetX: number;
    targetY: number;
    vx: number;
    vy: number;
    angle: number;
    targetAngle: number;
    speed: number;
    baseSpeed: number;
    state: 'WALK' | 'PAUSE' | 'HIDE' | 'PEEK' | 'SCARED';
    stateTimer: number;
    legPhase: number;
    size: number;
    hidingSpot: { x: number; y: number; edgeAngle: number; type: 'edge' | 'button' } | null;
    peekAmount: number; // 0 (fully visible) to 1 (mostly hidden except antennae/eyes)
    emotion: string | null;
    emotionTimer: number;
    sparkles: Array<{ x: number; y: number; vy: number; alpha: number; char: string }>;
  }

  function initCuteBugs() {
    const container = document.getElementById("bugs-container");
    const canvas = document.getElementById("bugs-canvas") as HTMLCanvasElement;
    if (!container || !canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animId: number;
    let dpr = window.devicePixelRatio || 1;

    // Track cursor for interaction
    let mouseX = -1000;
    let mouseY = -1000;
    let isHovering = false;

    function resize() {
      const rect = container!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx!.scale(dpr, dpr);
    }

    resize();
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);

    // Generate cute bugs
    const speciesList: Bug['species'][] = ['ladybug', 'emerald', 'firefly', 'pinkberry'];
    const bugs: Bug[] = speciesList.map((species, i) => ({
      id: i,
      species,
      x: 40 + Math.random() * (Math.max(100, width - 120)),
      y: Math.max(60, height * 0.4 + Math.random() * (height * 0.45)),
      targetX: 100,
      targetY: 100,
      vx: 0,
      vy: 0,
      angle: Math.random() * Math.PI * 2,
      targetAngle: 0,
      speed: 0.8 + Math.random() * 0.4,
      baseSpeed: 0.8 + Math.random() * 0.4,
      state: 'WALK',
      stateTimer: 2 + Math.random() * 3,
      legPhase: Math.random() * Math.PI * 2,
      size: 22 + Math.random() * 4,
      hidingSpot: null,
      peekAmount: 0,
      emotion: null,
      emotionTimer: 0,
      sparkles: []
    }));

    function getHidingSpots() {
      const spots: Array<{ x: number; y: number; edgeAngle: number; type: 'edge' | 'button' }> = [];
      const introCard = container!.parentElement;
      if (!introCard) return spots;

      // Card bottom edge spots
      const padding = 12;
      spots.push({ x: padding + 20, y: height - 6, edgeAngle: -Math.PI / 2, type: 'edge' });
      spots.push({ x: width / 2, y: height - 6, edgeAngle: -Math.PI / 2, type: 'edge' });
      spots.push({ x: width - padding - 40, y: height - 6, edgeAngle: -Math.PI / 2, type: 'edge' });
      spots.push({ x: 12, y: height / 2 + 30, edgeAngle: 0, type: 'edge' }); // Left edge

      // Button top/bottom hiding spots
      const buttons = introCard.querySelectorAll("button, a");
      const containerRect = container!.getBoundingClientRect();

      buttons.forEach((btn) => {
        const btnRect = btn.getBoundingClientRect();
        const relX = btnRect.left - containerRect.left + btnRect.width / 2;
        const relY = btnRect.top - containerRect.top + btnRect.height;
        if (relX > 0 && relX < width && relY > 0 && relY < height) {
          spots.push({ x: relX, y: relY - 4, edgeAngle: -Math.PI / 2, type: 'button' });
        }
      });

      return spots;
    }

    function setRandomWalkTarget(bug: Bug) {
      // Keep bugs in lower 65% area of the card where empty space is
      const minY = height * 0.35;
      const maxY = height - 16;
      const minX = 20;
      const maxX = width - 20;

      bug.targetX = minX + Math.random() * (maxX - minX);
      bug.targetY = minY + Math.random() * (maxY - minY);
      bug.state = 'WALK';
      bug.stateTimer = 2.5 + Math.random() * 4;
      bug.speed = bug.baseSpeed;
      bug.hidingSpot = null;
    }

    function setHidingTarget(bug: Bug) {
      const spots = getHidingSpots();
      if (spots.length === 0) {
        setRandomWalkTarget(bug);
        return;
      }
      const spot = spots[Math.floor(Math.random() * spots.length)];
      bug.hidingSpot = spot;
      bug.targetX = spot.x;
      bug.targetY = spot.y;
      bug.state = 'HIDE';
      bug.speed = bug.baseSpeed * 1.3;
    }

    function triggerEmotion(bug: Bug, char: string) {
      bug.emotion = char;
      bug.emotionTimer = 1.2;
    }

    function addSparkles(bug: Bug, char = '♥') {
      for (let i = 0; i < 3; i++) {
        bug.sparkles.push({
          x: bug.x + (Math.random() - 0.5) * 16,
          y: bug.y - 10,
          vy: -0.8 - Math.random() * 0.8,
          alpha: 1,
          char
        });
      }
    }

    // Interaction handlers
    container.addEventListener("mousemove", (e) => {
      const rect = container.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      isHovering = true;
    });

    container.addEventListener("mouseleave", () => {
      isHovering = false;
      mouseX = -1000;
      mouseY = -1000;
    });

    container.addEventListener("click", (e) => {
      const rect = container.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      bugs.forEach((bug) => {
        const dx = bug.x - clickX;
        const dy = bug.y - clickY;
        const dist = Math.hypot(dx, dy);

        if (dist < bug.size * 1.5) {
          // User clicked on this bug!
          triggerEmotion(bug, '♥');
          addSparkles(bug, Math.random() > 0.5 ? '♥' : '✨');
          bug.state = 'SCARED';
          bug.stateTimer = 1.8;
          bug.speed = bug.baseSpeed * 2.6;
          // Run away from click position
          bug.targetX = bug.x + Math.sign(dx || 1) * (80 + Math.random() * 60);
          bug.targetY = bug.y + Math.sign(dy || 1) * (60 + Math.random() * 40);
          // Clamp inside canvas
          bug.targetX = Math.max(20, Math.min(width - 20, bug.targetX));
          bug.targetY = Math.max(height * 0.35, Math.min(height - 20, bug.targetY));
        }
      });
    });

    let lastTime = performance.now();

    function update(dt: number) {
      bugs.forEach((bug) => {
        // Handle emotion timer
        if (bug.emotionTimer > 0) {
          bug.emotionTimer -= dt;
          if (bug.emotionTimer <= 0) bug.emotion = null;
        }

        // Handle sparkles
        bug.sparkles.forEach((s) => {
          s.y += s.vy;
          s.alpha -= dt * 1.2;
        });
        bug.sparkles = bug.sparkles.filter((s) => s.alpha > 0);

        // Proximity to cursor scare
        if (isHovering && bug.state !== 'SCARED' && bug.state !== 'PEEK') {
          const dx = bug.x - mouseX;
          const dy = bug.y - mouseY;
          const dist = Math.hypot(dx, dy);
          if (dist < 40) {
            triggerEmotion(bug, '!');
            bug.state = 'SCARED';
            bug.stateTimer = 1.5;
            bug.speed = bug.baseSpeed * 2.2;
            bug.targetX = bug.x + (dx / (dist || 1)) * 100;
            bug.targetY = bug.y + (dy / (dist || 1)) * 80;
            bug.targetX = Math.max(20, Math.min(width - 20, bug.targetX));
            bug.targetY = Math.max(height * 0.35, Math.min(height - 20, bug.targetY));
          }
        }

        // State Machine
        switch (bug.state) {
          case 'WALK':
          case 'HIDE':
          case 'SCARED': {
            const dx = bug.targetX - bug.x;
            const dy = bug.targetY - bug.y;
            const dist = Math.hypot(dx, dy);

            if (dist < 8) {
              if (bug.state === 'HIDE') {
                bug.state = 'PEEK';
                bug.stateTimer = 3 + Math.random() * 4;
                bug.peekAmount = 0.8;
                triggerEmotion(bug, '?');
              } else if (bug.state === 'SCARED') {
                setHidingTarget(bug);
              } else {
                // Decide next state: 40% hide, 30% pause, 30% new walk
                const rand = Math.random();
                if (rand < 0.45) {
                  setHidingTarget(bug);
                } else if (rand < 0.75) {
                  bug.state = 'PAUSE';
                  bug.stateTimer = 1.5 + Math.random() * 2.5;
                } else {
                  setRandomWalkTarget(bug);
                }
              }
            } else {
              bug.targetAngle = Math.atan2(dy, dx);
              // Smooth rotation angle interpolation
              let diff = bug.targetAngle - bug.angle;
              while (diff < -Math.PI) diff += Math.PI * 2;
              while (diff > Math.PI) diff -= Math.PI * 2;
              bug.angle += diff * Math.min(1, dt * 8);

              // Move
              bug.x += Math.cos(bug.angle) * bug.speed * (dt * 60);
              bug.y += Math.sin(bug.angle) * bug.speed * (dt * 60);

              // Leg animation
              bug.legPhase += bug.speed * dt * 14;

              // Reduce peek when walking
              bug.peekAmount = Math.max(0, bug.peekAmount - dt * 2);
            }

            bug.stateTimer -= dt;
            if (bug.stateTimer <= 0 && bug.state === 'WALK') {
              if (Math.random() < 0.5) setHidingTarget(bug);
              else setRandomWalkTarget(bug);
            }
            break;
          }

          case 'PAUSE': {
            bug.legPhase += dt * 2; // slow twitching
            bug.stateTimer -= dt;
            if (bug.stateTimer <= 0) {
              if (Math.random() < 0.6) setHidingTarget(bug);
              else setRandomWalkTarget(bug);
            }
            break;
          }

          case 'PEEK': {
            bug.legPhase += dt * 1.5;
            bug.stateTimer -= dt;
            bug.peekAmount = 0.7 + Math.sin(performance.now() * 0.003) * 0.1;

            if (bug.stateTimer <= 0) {
              bug.state = 'WALK';
              triggerEmotion(bug, '✨');
              setRandomWalkTarget(bug);
            }
            break;
          }
        }
      });
    }

    function drawBug(b: Bug) {
      ctx!.save();
      ctx!.translate(b.x, b.y);

      // If peeking, rotate towards edge or hiding spot angle
      const renderAngle = b.state === 'PEEK' && b.hidingSpot ? b.hidingSpot.edgeAngle : b.angle;
      ctx!.rotate(renderAngle + Math.PI / 2); // default face up

      const s = b.size;

      // Draw Sparks/Heart floating
      b.sparkles.forEach((sp) => {
        ctx!.save();
        ctx!.globalAlpha = sp.alpha;
        ctx!.fillStyle = '#f43f5e';
        ctx!.font = 'bold 12px sans-serif';
        ctx!.fillText(sp.char, sp.x - b.x, sp.y - b.y);
        ctx!.restore();
      });

      // Draw Emotion indicator (speech bubble)
      if (b.emotion) {
        ctx!.save();
        ctx!.fillStyle = 'rgba(15, 23, 42, 0.9)';
        ctx!.strokeStyle = '#38bdf8';
        ctx!.lineWidth = 1.5;
        const eX = 0;
        const eY = -s * 1.3;

        ctx!.beginPath();
        ctx!.arc(eX, eY, 9, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.stroke();

        ctx!.fillStyle = '#ffffff';
        ctx!.font = 'bold 10px sans-serif';
        ctx!.textAlign = 'center';
        ctx!.textBaseline = 'middle';
        ctx!.fillText(b.emotion, eX, eY);
        ctx!.restore();
      }

      // Clip/Hide effect if peekAmount > 0
      if (b.peekAmount > 0) {
        ctx!.beginPath();
        ctx!.rect(-s * 1.5, -s * 1.5 + b.peekAmount * s * 1.2, s * 3, s * 3);
        ctx!.clip();
      }

      // Draw 6 Wiggly Legs
      ctx!.strokeStyle = '#1e293b';
      ctx!.lineWidth = 2;
      ctx!.lineCap = 'round';

      for (let side = -1; side <= 1; side += 2) {
        for (let legIdx = 0; legIdx < 3; legIdx++) {
          const legY = (legIdx - 1) * (s * 0.3);
          const phaseOffset = legIdx * 0.8 + (side > 0 ? Math.PI : 0);
          const legSwing = Math.sin(b.legPhase + phaseOffset) * 0.4;

          const startX = side * (s * 0.35);
          const startY = legY;
          const midX = side * (s * 0.65 + Math.cos(legSwing) * 3);
          const midY = legY + Math.sin(legSwing) * 5;
          const endX = side * (s * 0.85);
          const endY = legY + side * legSwing * 6;

          ctx!.beginPath();
          ctx!.moveTo(startX, startY);
          ctx!.quadraticCurveTo(midX, midY, endX, endY);
          ctx!.stroke();
        }
      }

      // Draw Antennae
      const antennaPhase = Math.sin(performance.now() * 0.008 + b.id) * 0.2;
      ctx!.strokeStyle = '#0f172a';
      ctx!.lineWidth = 1.5;

      for (let side = -1; side <= 1; side += 2) {
        const aX = side * (s * 0.2);
        const aY = -s * 0.45;
        const tipX = side * (s * 0.5) + antennaPhase * 4;
        const tipY = -s * 0.85;

        ctx!.beginPath();
        ctx!.moveTo(aX, aY);
        ctx!.quadraticCurveTo(side * (s * 0.3), -s * 0.75, tipX, tipY);
        ctx!.stroke();

        // Cute antenna ball tip
        ctx!.fillStyle = b.species === 'pinkberry' ? '#f43f5e' : (b.species === 'emerald' ? '#10b981' : '#ef4444');
        ctx!.beginPath();
        ctx!.arc(tipX, tipY, 2, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Draw Body & Shell based on species
      ctx!.save();

      if (b.species === 'ladybug') {
        // Red Glossy Shell
        ctx!.fillStyle = '#ef4444';
        ctx!.beginPath();
        ctx!.ellipse(0, 0, s * 0.42, s * 0.5, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Dark Head
        ctx!.fillStyle = '#1e293b';
        ctx!.beginPath();
        ctx!.ellipse(0, -s * 0.4, s * 0.3, s * 0.2, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Center split line
        ctx!.strokeStyle = '#0f172a';
        ctx!.lineWidth = 1.2;
        ctx!.beginPath();
        ctx!.moveTo(0, -s * 0.3);
        ctx!.lineTo(0, s * 0.48);
        ctx!.stroke();

        // Black Spots
        ctx!.fillStyle = '#0f172a';
        const spots = [
          { x: -s * 0.2, y: -s * 0.1, r: s * 0.08 },
          { x: s * 0.2, y: -s * 0.1, r: s * 0.08 },
          { x: -s * 0.22, y: s * 0.2, r: s * 0.09 },
          { x: s * 0.22, y: s * 0.2, r: s * 0.09 },
        ];
        spots.forEach((sp) => {
          ctx!.beginPath();
          ctx!.arc(sp.x, sp.y, sp.r, 0, Math.PI * 2);
          ctx!.fill();
        });

      } else if (b.species === 'emerald') {
        // Shiny Emerald Green Shell
        const grad = ctx!.createLinearGradient(-s * 0.4, -s * 0.4, s * 0.4, s * 0.4);
        grad.addColorStop(0, '#34d399');
        grad.addColorStop(0.6, '#059669');
        grad.addColorStop(1, '#064e3b');

        ctx!.fillStyle = grad;
        ctx!.beginPath();
        ctx!.ellipse(0, 0, s * 0.4, s * 0.52, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Head
        ctx!.fillStyle = '#064e3b';
        ctx!.beginPath();
        ctx!.ellipse(0, -s * 0.4, s * 0.28, s * 0.2, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Gold center stripe
        ctx!.strokeStyle = '#fbbf24';
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.moveTo(0, -s * 0.3);
        ctx!.lineTo(0, s * 0.48);
        ctx!.stroke();

      } else if (b.species === 'firefly') {
        // Glowing Amber Bug
        ctx!.fillStyle = '#f59e0b';
        ctx!.beginPath();
        ctx!.ellipse(0, 0, s * 0.4, s * 0.48, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Head
        ctx!.fillStyle = '#78350f';
        ctx!.beginPath();
        ctx!.ellipse(0, -s * 0.38, s * 0.28, s * 0.18, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Glowing Tail Abdomen
        const glowRadius = s * 0.35 + Math.sin(performance.now() * 0.006) * 3;
        const glowGrad = ctx!.createRadialGradient(0, s * 0.3, 2, 0, s * 0.3, glowRadius);
        glowGrad.addColorStop(0, 'rgba(254, 240, 138, 0.9)');
        glowGrad.addColorStop(0.5, 'rgba(234, 179, 8, 0.5)');
        glowGrad.addColorStop(1, 'rgba(234, 179, 8, 0)');

        ctx!.fillStyle = glowGrad;
        ctx!.beginPath();
        ctx!.arc(0, s * 0.3, glowRadius, 0, Math.PI * 2);
        ctx!.fill();

      } else { // pinkberry
        // Cute Pink Polka Shell
        ctx!.fillStyle = '#f43f5e';
        ctx!.beginPath();
        ctx!.ellipse(0, 0, s * 0.42, s * 0.48, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Head
        ctx!.fillStyle = '#881337';
        ctx!.beginPath();
        ctx!.ellipse(0, -s * 0.38, s * 0.28, s * 0.18, 0, 0, Math.PI * 2);
        ctx!.fill();

        // White Polka Dots
        ctx!.fillStyle = '#ffffff';
        const dots = [
          { x: -s * 0.18, y: -s * 0.1, r: s * 0.06 },
          { x: s * 0.18, y: -s * 0.1, r: s * 0.06 },
          { x: 0, y: s * 0.12, r: s * 0.07 },
          { x: -s * 0.2, y: s * 0.25, r: s * 0.06 },
          { x: s * 0.2, y: s * 0.25, r: s * 0.06 },
        ];
        dots.forEach((d) => {
          ctx!.beginPath();
          ctx!.arc(d.x, d.y, d.r, 0, Math.PI * 2);
          ctx!.fill();
        });
      }

      // Glossy Highlight Reflection on shell
      ctx!.fillStyle = 'rgba(255, 255, 255, 0.4)';
      ctx!.beginPath();
      ctx!.ellipse(-s * 0.15, -s * 0.15, s * 0.12, s * 0.2, -Math.PI / 4, 0, Math.PI * 2);
      ctx!.fill();

      // Cute Eyes on Head
      ctx!.fillStyle = '#ffffff';
      ctx!.beginPath();
      ctx!.arc(-s * 0.12, -s * 0.45, s * 0.09, 0, Math.PI * 2);
      ctx!.arc(s * 0.12, -s * 0.45, s * 0.09, 0, Math.PI * 2);
      ctx!.fill();

      // Eye Pupils
      ctx!.fillStyle = '#0f172a';
      if (b.state === 'PEEK' || b.state === 'PAUSE') {
        // Pupils looking around
        const pX = Math.sin(performance.now() * 0.004) * (s * 0.03);
        ctx!.beginPath();
        ctx!.arc(-s * 0.12 + pX, -s * 0.45, s * 0.045, 0, Math.PI * 2);
        ctx!.arc(s * 0.12 + pX, -s * 0.45, s * 0.045, 0, Math.PI * 2);
        ctx!.fill();
      } else {
        ctx!.beginPath();
        ctx!.arc(-s * 0.12, -s * 0.46, s * 0.045, 0, Math.PI * 2);
        ctx!.arc(s * 0.12, -s * 0.46, s * 0.045, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.restore();
      ctx!.restore();
    }

    function render(time: number) {
      const dt = Math.min(0.1, (time - lastTime) / 1000);
      lastTime = time;

      ctx!.clearRect(0, 0, width, height);

      update(dt);
      bugs.forEach(drawBug);

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);

    return () => {
      cancelAnimationFrame(animId);
      resizeObserver.disconnect();
    };
  }

  let cleanup: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    if (cleanup) cleanup();
    cleanup = initCuteBugs();
  });

  document.addEventListener("astro:before-swap", () => {
    if (cleanup) cleanup();
  });
</script>
