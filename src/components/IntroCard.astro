---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS } from "../lib/constants";
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip/index";
import { Image } from "astro:assets";
import { SITE } from "../site-config";
import MemojiAvatarDefault from "../assets/vietdoo_pixel.png";
import MemojiAvatarBlue from "../assets/vietdoo_pixel.png";
import MemojiAvatarGreen from "../assets/vietdoo_pixel.png";
import MemojiAvatarPurple from "../assets/vietdoo_pixel.png";
import MemojiAvatarYellow from "../assets/vietdoo_pixel.png";
import CuteBugs from "./CuteBugs.astro";

const themeSources = {
  "data-memoji": true,
  "data-theme-default": MemojiAvatarDefault.src,
  "data-theme-yellow-theme": MemojiAvatarYellow.src,
  "data-theme-blue-theme": MemojiAvatarBlue.src,
  "data-theme-green-theme": MemojiAvatarGreen.src,
  "data-theme-purple-theme": MemojiAvatarPurple.src,
};

const socials = [
  { href: LINKS.github, icon: "ri:github-fill", label: "github profile", event: "github button" },
  { href: LINKS.linkedin, icon: "ri:linkedin-box-fill", label: "linkedin profile", event: "linkedin button" },
  { href: SITE.site.url, icon: "ri:global-line", label: "website", event: "website button" },
];
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4">
  {/* Bugs roam the whole card on desktop, but only a dedicated strip at the bottom on mobile. */}
  <div
    slot="background"
    class="absolute inset-x-0 bottom-0 h-[136px] md:inset-0 md:h-auto pointer-events-auto"
  >
    <CuteBugs />
  </div>

  {/* ---------- Mobile layout ---------- */}
  <div class="flex flex-col gap-4 relative z-10 pb-[124px] md:hidden">
    <div data-bug-safe-below class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <Image
          quality="max"
          src={MemojiAvatarDefault}
          {...themeSources}
          class="h-14 w-14 shrink-0 rounded-full object-cover object-top bg-darkslate-700 border border-darkslate-400 select-none"
          alt={`memoji of ${SITE.author.firstName}`}
          loading="eager"
          fetchpriority="high"
        />
        <div class="flex flex-col min-w-0">
          <span class="text-[11px] uppercase tracking-widest text-darkslate-300">welcome</span>
          <span class="text-base font-bold leading-tight truncate">{SITE.author.fullName}</span>
          <span class="text-xs text-primary-400 leading-tight truncate">{SITE.author.jobTitle}</span>
        </div>
      </div>

      <p class="sr-only">
        Hi, I'm {SITE.author.fullName} ({SITE.author.shortName}), a Software Engineer @ VNPT Group specializing in Big Data, Data Engineering, and scalable microservices. Feel free to reach out to me if you have any project in mind, want to collaborate, or just want to say hello.
      </p>
      <p aria-hidden="true" class="m-0 text-[13px] font-light leading-relaxed text-white/80">
        Software Engineer specializing in <b class="font-semibold text-white">Big Data</b>, Data
        Engineering and scalable microservices. Reach out if you have a project in mind or just want
        to say hello.
      </p>

      <a href={`mailto:${LINKS.email}`} class="block">
        <Button
          aria-label="send a message"
          class="!w-full !max-h-none !py-2.5 !text-sm flex items-center justify-center gap-2"
        >
          <Icon name="ri:mail-send-line" class="h-4 w-4" />
          <span data-umami-event="Send a message" class="font-bold">Send a message</span>
        </Button>
      </a>

      <div class="grid grid-cols-4 gap-2">
        {
          socials.map((social) => (
            <a href={social.href} aria-label={social.label} target="_blank" class="block">
              <Button aria-label={social.label} class="!w-full !max-h-none !py-2 flex items-center justify-center">
                <Icon name={social.icon} class="h-5 w-5" />
                <span class="sr-only" data-umami-event={social.event}>
                  {social.label}
                </span>
              </Button>
            </a>
          ))
        }
        <Tooltip client:visible class="!block w-full">
          <Button
            aria-label="easter egg btn"
            class="!w-full !max-h-none !py-2 flex items-center justify-center"
          >
            <Icon name="ri:emotion-laugh-line" class="h-5 w-5" />
            <span class="sr-only" data-umami-event="Easter egg button">Easter egg button</span>
          </Button>
        </Tooltip>
      </div>
    </div>
  </div>

  {/* ---------- Desktop layout ---------- */}
  <div class="hidden md:flex w-full h-full relative z-10 pointer-events-none">
    <div data-bug-safe-below class="flex flex-col justify-between md:max-h-[300px] gap-3 md:gap-4 pointer-events-auto">
      <div class="flex flex-col h-full">
        <h6 class="text-sm font-light m-0 text-darkslate-300">welcome</h6>

        <p aria-hidden="true" class="m-0 font-light text-sm md:text-base">
          <span>
            Hi, I'm <b class="font-bold">{SITE.author.fullName}</b> (<span class="text-primary-400 font-semibold">{SITE.author.shortName}</span>), a Software Engineer @ VNPT Group specializing in Big Data, Data Engineering, and scalable microservices.
          </span>
          <br />
          <span class="block mt-2">
            Feel free to reach out to me if you have any project in mind, want to collaborate, or just want to say hello.
          </span>
        </p>
      </div>
      <div class="flex flex-col lg:flex-row gap-2 lg:gap-4">
        <div class="flex gap-2 lg:gap-4">
          {
            socials.map((social) => (
              <a href={social.href} aria-label={social.label} target="_blank">
                <Button aria-label={social.label}>
                  <Icon name={social.icon} />
                  <span class="sr-only" data-umami-event={social.event}>
                    {social.label}
                  </span>
                </Button>
              </a>
            ))
          }
          <Tooltip client:visible>
            <Button aria-label="easter egg btn">
              <Icon name="ri:emotion-laugh-line" />
              <span class="sr-only" data-umami-event="Easter egg button"
                >Easter egg button</span
              >
            </Button>
          </Tooltip>
        </div>
        <a href={`mailto:${LINKS.email}`} class="contents">
          <Button aria-label="send a message">
            <span
              data-umami-event="Send a message"
              class="font-bold whitespace-nowrap">Send a message</span
            >
          </Button>
        </a>
      </div>
    </div>
    <Image
      id="memoji-avatar"
      quality="max"
      src={MemojiAvatarDefault}
      {...themeSources}
      class="w-auto max-h-[300px] select-none relative z-[-1] opacity-100 pointer-events-none"
      alt={`memoji of ${SITE.author.firstName}`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</Card>

<script>
  import { animate } from "motion";

  function updateMemojiImage() {
    const avatars = document.querySelectorAll<HTMLImageElement>("[data-memoji]");
    if (avatars.length === 0) return;

    const theme = localStorage.getItem("theme") || "default";
    const themeClass = theme === "default" ? "default" : theme;

    avatars.forEach((avatarImg) => {
      const imageSrc =
        avatarImg.getAttribute(`data-theme-${themeClass}`) ||
        avatarImg.getAttribute("data-theme-default");

      if (imageSrc && avatarImg.src !== imageSrc) {
        avatarImg.src = imageSrc;
        if (avatarImg.srcset) {
          avatarImg.srcset = "";
        }
      }
    });
  }

  function initLevitatingAnimation() {
    const avatarImg = document.getElementById("memoji-avatar") as HTMLElement;
    if (!avatarImg) return;

    animate(
      avatarImg,
      { y: [-10, 10, -10] },
      {
        duration: 3,
        repeat: Infinity,
        ease: "easeInOut",
      },
    );
  }

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "class"
      ) {
        updateMemojiImage();
      }
    });
  });

  document.addEventListener("astro:page-load", () => {
    updateMemojiImage();
    initLevitatingAnimation();
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  });

  document.addEventListener("astro:before-swap", () => observer.disconnect());
  document.addEventListener("themechange", updateMemojiImage);
</script>
