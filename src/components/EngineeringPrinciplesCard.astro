---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";

const principles = [
  {
    icon: "ri:lightbulb-line",
    title: "Simplicity over cleverness",
    subtitle: "Small solutions age better than clever ones.",
  },
  {
    icon: "ri:line-chart-line",
    title: "Scale by design",
    subtitle: "Think beyond today's traffic.",
  },
  {
    icon: "ri:bar-chart-2-line",
    title: "Measure before optimize",
    subtitle: "Data beats assumptions.",
  },
  {
    icon: "ri:robot-3-line",
    title: "Automate everything repeatable",
    subtitle: "Humans solve problems, machines repeat them.",
  },
  {
    icon: "ri:shield-check-line",
    title: "Clean code survives longer",
    subtitle: "Readable code is maintainable code.",
  },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  {/* Subtle dotted matrix decorative footer */}
  <div
    slot="background"
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-36 pointer-events-none opacity-20 bg-[radial-gradient(var(--primary-400)_1.2px,transparent_1.2px)] [background-size:12px_12px] [mask-image:linear-gradient(to_bottom,transparent_0%,black_100%)] select-none"
  >
  </div>

  <div class="h-full flex flex-col justify-between relative z-10 select-none">
    {/* Top Header Section */}
    <div class="flex items-start justify-between gap-2 mb-2 sm:mb-3">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white leading-tight m-0 tracking-tight">
          Engineering
        </h2>
        <h2 class="text-lg sm:text-xl font-bold text-white leading-tight m-0 tracking-tight">
          Principles
        </h2>
      </div>
      <div class="text-primary-400 p-1.5 shrink-0" aria-hidden="true">
        <Icon name="ri:code-s-slash-line" class="h-6 w-6 sm:h-7 sm:w-7" />
      </div>
    </div>

    {/* Middle Section: 5 Principles */}
    <ul class="space-y-3 sm:space-y-3.5 m-0 p-0 list-none">
      {
        principles.map((item) => (
          <li class="flex items-start gap-3 group/item">
            <Icon
              name={item.icon}
              class="h-5 w-5 text-primary-400 shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform duration-150"
            />
            <div class="flex flex-col min-w-0">
              <span class="text-xs sm:text-[13px] font-semibold text-white group-hover/item:text-primary-300 transition-colors duration-150 leading-snug">
                {item.title}
              </span>
              <span class="text-[10px] sm:text-[11px] text-neutral-400 font-normal leading-tight mt-0.5 line-clamp-1">
                {item.subtitle}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Card>
