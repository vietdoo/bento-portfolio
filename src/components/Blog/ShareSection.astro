---
interface Props {
  title: string;
  lang: "vi" | "en";
}

const { title, lang } = Astro.props;

const shareLabel = lang === "vi" ? "Chia sẻ bài viết này" : "Share this article";
const copyLinkLabel = lang === "vi" ? "Sao chép link" : "Copy link";
const copiedText = lang === "vi" ? "Đã sao chép!" : "Copied!";
---

<div
  class="mt-12 pt-8 border-t border-solid border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
  data-share-section
>
  <div>
    <h3 class="text-base font-semibold text-neutral-200 m-0">
      {shareLabel}
    </h3>
    <p class="text-xs text-neutral-400 mt-1 mb-0">
      {lang === "vi" ? "Nếu bạn thấy bài viết hữu ích, hãy chia sẻ tới cộng đồng." : "Found this post helpful? Feel free to share it with your network."}
    </p>
  </div>

  <div class="flex items-center gap-2 flex-wrap">
    <!-- Copy Link Button -->
    <button
      type="button"
      data-share-copy
      data-copied-label={copiedText}
      data-default-label={copyLinkLabel}
      class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-neutral-700 bg-neutral-900/80 text-xs font-medium text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-neutral-800 transition-all cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span data-copy-text>{copyLinkLabel}</span>
    </button>

    <!-- X / Twitter -->
    <a
      href="https://twitter.com/intent/tweet"
      data-share-twitter
      data-title={title}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center p-2 rounded-lg border border-neutral-700 bg-neutral-900/80 text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-neutral-800 transition-all decoration-none"
      title="Share on X"
      aria-label="Share on X"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href="https://www.linkedin.com/sharing/share-offsite/"
      data-share-linkedin
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center p-2 rounded-lg border border-neutral-700 bg-neutral-900/80 text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-neutral-800 transition-all decoration-none"
      title="Share on LinkedIn"
      aria-label="Share on LinkedIn"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.65 1.65 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66s1.66-.74 1.66-1.66a1.66 1.66 0 0 0-1.66-1.66z"/>
      </svg>
    </a>

    <!-- Facebook -->
    <a
      href="https://www.facebook.com/sharer/sharer.php"
      data-share-facebook
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center p-2 rounded-lg border border-neutral-700 bg-neutral-900/80 text-neutral-300 hover:text-white hover:border-neutral-500 hover:bg-neutral-800 transition-all decoration-none"
      title="Share on Facebook"
      aria-label="Share on Facebook"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.5v-3H10V9.5C10 7.01 11.49 5.6 13.74 5.6c1.08 0 2.22.19 2.22.19v2.44h-1.25c-1.23 0-1.61.77-1.61 1.56V12h2.77l-.44 3h-2.33v6.8C18.56 20.87 22 16.84 22 12z"/>
      </svg>
    </a>
  </div>
</div>

<script>
  function setupShareSection() {
    const shareSections = document.querySelectorAll("[data-share-section]");

    shareSections.forEach((section) => {
      const currentUrl = window.location.href;
      const copyBtn = section.querySelector<HTMLButtonElement>("[data-share-copy]");
      const copyTextSpan = section.querySelector<HTMLSpanElement>("[data-copy-text]");
      const twitterLink = section.querySelector<HTMLAnchorElement>("[data-share-twitter]");
      const linkedinLink = section.querySelector<HTMLAnchorElement>("[data-share-linkedin]");
      const facebookLink = section.querySelector<HTMLAnchorElement>("[data-share-facebook]");

      if (twitterLink) {
        const title = twitterLink.dataset.title || document.title;
        twitterLink.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`;
      }

      if (linkedinLink) {
        linkedinLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
      }

      if (facebookLink) {
        facebookLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
      }

      if (copyBtn && copyTextSpan) {
        copyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(currentUrl);
            const defaultLabel = copyBtn.dataset.defaultLabel || "Copy link";
            const copiedLabel = copyBtn.dataset.copiedLabel || "Copied!";

            copyTextSpan.textContent = copiedLabel;
            copyBtn.classList.add("border-primary-500", "text-primary-400");

            setTimeout(() => {
              copyTextSpan.textContent = defaultLabel;
              copyBtn.classList.remove("border-primary-500", "text-primary-400");
            }, 2000);
          } catch (e) {
            console.error("Failed to copy link", e);
          }
        });
      }
    });
  }

  document.addEventListener("astro:page-load", setupShareSection);
</script>
