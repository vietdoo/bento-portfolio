---
import { BLOG_LANG_KEY, type BlogLang } from "../../lib/blog-lang";

interface Props {
  current: BlogLang;
  enHref?: string | undefined;
  viHref?: string | undefined;
  class?: string;
}

const {
  current,
  enHref,
  viHref,
  class: extraClass = "",
} = Astro.props as Props;

const options: { lang: BlogLang; label: string; href?: string | undefined }[] =
  [
    { lang: "en", label: "EN", href: enHref },
    { lang: "vi", label: "VI", href: viHref },
  ];
---

<div
  class:list={[
    "inline-flex items-center gap-1 p-1 rounded-lg border border-solid border-neutral-700 bg-neutral-900/90",
    extraClass,
  ]}
  data-lang-toggle
  data-storage-key={BLOG_LANG_KEY}
>
  {
    options.map(({ lang, label, href }) => {
      const isSelected = lang === current;
      return href ? (
        <a
          href={href}
          data-lang-option={lang}
          data-active={isSelected ? "true" : "false"}
          aria-current={isSelected ? "page" : undefined}
          class="lang-option px-3 py-1 text-xs font-semibold rounded-md decoration-none transition-colors"
        >
          {label}
        </a>
      ) : (
        <button
          type="button"
          data-lang-option={lang}
          data-active={isSelected ? "true" : "false"}
          aria-pressed={isSelected ? "true" : "false"}
          class="lang-button px-3 py-1 text-xs font-semibold rounded-md border-none cursor-pointer transition-colors"
        >
          {label}
        </button>
      );
    })
  }
</div>

<style is:global>
  [data-lang-toggle] [data-lang-option] {
    transition: background-color 0.15s ease, color 0.15s ease;
    background-color: transparent !important;
    color: #d4d4d4 !important;
  }

  [data-lang-toggle] [data-lang-option]:hover {
    color: #ffffff !important;
  }

  [data-lang-toggle] [data-lang-option][data-active="true"] {
    background-color: var(--primary-500) !important;
    color: #0b0b0b !important;
    font-weight: 700 !important;
  }

  [data-lang-toggle] [data-lang-option][data-active="false"] {
    background-color: transparent !important;
    color: #d4d4d4 !important;
    font-weight: 500 !important;
  }
</style>

<script>
  import { BLOG_LANG_KEY } from "../../lib/blog-lang";

  function rememberLangChoice() {
    document
      .querySelectorAll<HTMLElement>("[data-lang-toggle] [data-lang-option]")
      .forEach((option) => {
        option.addEventListener("click", () => {
          const lang = option.dataset.langOption;
          if (lang) localStorage.setItem(BLOG_LANG_KEY, lang);
        });
      });
  }

  document.addEventListener("astro:page-load", rememberLangChoice);
</script>
