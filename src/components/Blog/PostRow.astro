---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../lib/helpers";
import { getBlogPostHref } from "../../lib/blog-lang";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<li
  class="list-none w-full text-neutral-100 hover:text-neutral-400 ease-in-out transition-colors border-b-neutral-400 border-dashed border-b-1 my-2"
  data-post-lang={post.data.lang}
>
  <a
    class="text-sm md:text-base decoration-none flex justify-between gap-4"
    href={getBlogPostHref(post)}
  >
    <p class="inline-block">
      {post.data.title ?? post.id}
    </p>
    <time
      class="text-right tabular-nums whitespace-nowrap"
      data-date={post.data.pubDate?.toISOString()}
      datetime={post.data.pubDate?.toISOString()}
    >
      {post.data.pubDate && formatDate(post.data.pubDate)}
    </time>
  </a>
</li>
