---
import Card from "./Card/index.astro";
import { booksData } from "../data/books";

const currentlyReading = booksData.find((b) => b.status === "reading");

// Split books for 2 background shelf rows
const row1Books = booksData.slice(0, 6);
const row2Books = booksData.slice(6, 12);

// Varied spine colors, heights, and styles for natural bookshelf feel
const spineStyles = [
  { color: "from-zinc-600 via-zinc-700 to-zinc-900", height: "h-11", width: "w-4" },
  { color: "from-neutral-500 via-neutral-600 to-zinc-900", height: "h-13", width: "w-5" },
  { color: "from-stone-600 via-stone-700 to-zinc-900", height: "h-10", width: "w-3.5" },
  { color: "from-slate-600 via-slate-700 to-zinc-900", height: "h-12", width: "w-4" },
  { color: "from-zinc-500 via-zinc-700 to-zinc-900", height: "h-14", width: "w-4.5" },
  { color: "from-neutral-600 via-neutral-700 to-zinc-900", height: "h-10.5", width: "w-3.5" },
];
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  href="/books"
>
  <div slot="background" class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Animated Bookshelf Background ("Kệ Sách") -->
    <div class="bookshelf-grid-container w-full h-full relative flex flex-col justify-between p-3 pt-4 opacity-75 group-hover:opacity-100 transition-opacity duration-500 select-none">
      
      <!-- Shelf Row 1 -->
      <div class="shelf-row flex items-end justify-between px-1 relative pb-0.5">
        <!-- Metallic/Glass Shelf Bar -->
        <div class="absolute bottom-0 inset-x-0 h-[2px] bg-gradient-to-r from-white/20 via-white/10 to-white/20 shadow-sm"></div>
        
        {row1Books.map((book, idx) => {
          const style = spineStyles[idx % spineStyles.length];
          const isFeatured = idx === 0 || idx === 3;
          return (
            <div
              class={`bs-spine relative rounded-t-[2px] border-t border-x border-white/20 transition-all duration-500 ease-out flex-shrink-0 ${
                isFeatured ? "w-9 h-13 shadow-md overflow-hidden bg-zinc-800" : `${style.width} ${style.height} bg-gradient-to-b ${style.color}`
              }`}
              style={`animation: shelfFloat 3s ease-in-out infinite alternate ${idx * 0.25}s;`}
              data-index={idx}
            >
              {isFeatured ? (
                <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover opacity-90" loading="lazy" />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-between py-1.5 opacity-50">
                  <div class="w-1.5 h-1 rounded-full bg-white/40"></div>
                  <div class="w-0.5 h-6 bg-white/20"></div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      <!-- Shelf Row 2 -->
      <div class="shelf-row flex items-end justify-between px-1 relative pb-0.5">
        <!-- Metallic/Glass Shelf Bar -->
        <div class="absolute bottom-0 inset-x-0 h-[2px] bg-gradient-to-r from-white/20 via-white/10 to-white/20 shadow-sm"></div>

        {row2Books.map((book, idx) => {
          const style = spineStyles[(idx + 2) % spineStyles.length];
          const isFeatured = idx === 1 || idx === 4;
          return (
            <div
              class={`bs-spine relative rounded-t-[2px] border-t border-x border-white/20 transition-all duration-500 ease-out flex-shrink-0 ${
                isFeatured ? "w-9 h-13 shadow-md overflow-hidden bg-zinc-800" : `${style.width} ${style.height} bg-gradient-to-b ${style.color}`
              }`}
              style={`animation: shelfFloat 3.5s ease-in-out infinite alternate ${(idx + 3) * 0.3}s;`}
              data-index={idx + 6}
            >
              {isFeatured ? (
                <img src={book.coverImage} alt={book.title} class="w-full h-full object-cover opacity-90" loading="lazy" />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-between py-1.5 opacity-50">
                  <div class="w-1.5 h-1 rounded-full bg-white/40"></div>
                  <div class="w-0.5 h-6 bg-white/20"></div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      <!-- Overlay Dark Gradient for Contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-darkslate-600 via-darkslate-600/75 to-darkslate-600/30 pointer-events-none"></div>
    </div>
  </div>

  <!-- Content Layer (Clean Without Reading Log / 12 books badges) -->
  <div class="flex-1 flex flex-col justify-end h-full relative z-10 p-1">
    <div>
      <h2 class="text-xl font-bold text-white m-0 tracking-tight">Bookshelf</h2>
      {currentlyReading && (
        <p class="text-xs text-darkslate-300 m-0 mt-1 line-clamp-1">
          <span class="text-white/60">Reading:</span> {currentlyReading.title}
        </p>
      )}
    </div>
  </div>
</Card>

<style>
  @keyframes shelfFloat {
    0% {
      transform: translateY(0px);
    }
    100% {
      transform: translateY(-4px);
    }
  }

  .bs-spine.active {
    transform: translateY(-6px) scale(1.06) !important;
    border-color: rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2) !important;
  }
</style>

<script is:inline>
  (function setupBookshelf() {
    function startAnimation() {
      const container = document.querySelector('.bookshelf-grid-container');
      if (!container) return;
      const spines = container.querySelectorAll('.bs-spine');
      if (!spines.length) return;

      const card = container.closest('.card') || container.parentElement;

      if (container.dataset.animated === 'true') return;
      container.dataset.animated = 'true';

      if (card) {
        card.addEventListener('mousemove', (e) => {
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left;

          spines.forEach((spine) => {
            const sRect = spine.getBoundingClientRect();
            const sX = sRect.left - rect.left + sRect.width / 2;
            const dist = Math.abs(x - sX);

            if (dist < 35) {
              spine.classList.add('active');
              setTimeout(() => {
                spine.classList.remove('active');
              }, 400);
            }
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startAnimation);
    } else {
      startAnimation();
    }
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.bookshelf-grid-container');
      if (container) container.dataset.animated = 'false';
      startAnimation();
    });
  })();
</script>
