---
import Card from "./Card/index.astro";
import { booksData } from "../data/books";

const featuredCovers = booksData.slice(0, 4);
const currentlyReading = booksData.find((b) => b.status === "reading");
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  href="/books"
>
  <div slot="background" class="absolute inset-0 overflow-hidden pointer-events-none opacity-40 group-hover:opacity-65 transition-all duration-300">
    <div class="absolute -right-3 -bottom-5 flex gap-2.5 transform -rotate-6 group-hover:-rotate-3 group-hover:scale-105 transition-all duration-500 ease-out">
      {featuredCovers.map((book, idx) => (
        <div 
          class="w-14 h-22 rounded-lg shadow-lg border border-white/10 overflow-hidden flex-shrink-0 bg-darkslate-700 transform relative"
          style={`transform: translateY(${idx * 3}px) rotate(${idx * 2 - 3}deg); z-index: ${5 - idx};`}
        >
          <img 
            src={book.coverImage} 
            alt={book.title}
            class="w-full h-full object-cover"
            loading="lazy" 
          />
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-darkslate-500 via-darkslate-500/70 to-transparent"></div>
  </div>

  <div class="flex flex-col justify-between h-full relative z-10">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
      </span>
      <span class="text-[10px] font-semibold tracking-wider uppercase text-primary-400">Reading Log</span>
    </div>

    <div>
      <h2 class="text-xl font-bold text-white m-0 tracking-tight">Bookshelf 📚</h2>
      {currentlyReading && (
        <p class="text-xs text-darkslate-300 m-0 mt-1 line-clamp-1">
          <span class="text-white/60">Reading:</span> {currentlyReading.title}
        </p>
      )}
    </div>
  </div>
</Card>
