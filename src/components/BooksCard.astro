---
import Card from "./Card/index.astro";
import { booksData } from "../data/books";

const featuredCovers = booksData.slice(0, 4);
const currentlyReading = booksData.find((b) => b.status === "reading");
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  href="/books"
>
  <div slot="background" class="absolute inset-0 overflow-hidden pointer-events-none opacity-40 group-hover:opacity-75 transition-all duration-500">
    <!-- Classic Wooden Shelf Backdrop preview -->
    <div class="absolute -right-3 -bottom-5 flex gap-2.5 transform -rotate-6 group-hover:-rotate-3 group-hover:scale-105 transition-all duration-500 ease-out">
      {featuredCovers.map((book, idx) => (
        <div 
          class="w-14 h-22 rounded-r rounded-l-xs shadow-[0_8px_20px_rgba(0,0,0,0.9)] border border-amber-700/50 overflow-hidden flex-shrink-0 bg-amber-950 transform relative"
          style={`transform: translateY(${idx * 3}px) rotate(${idx * 2 - 3}deg); z-index: ${5 - idx};`}
        >
          <img 
            src={book.coverImage} 
            alt={book.title}
            class="w-full h-full object-cover"
            loading="lazy" 
          />
          <div class="absolute inset-y-0 left-0 w-2 bg-gradient-to-r from-black/60 to-transparent"></div>
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-darkslate-600 via-darkslate-600/60 to-transparent"></div>
  </div>

  <div class="flex flex-col justify-between h-full relative z-10 font-serif">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span class="text-[10px] font-sans font-bold tracking-widest uppercase text-amber-400/90">Classic Library</span>
    </div>

    <div>
      <h2 class="text-xl font-bold text-amber-100 m-0 tracking-tight">Bookshelf 📚</h2>
      {currentlyReading && (
        <p class="text-[11px] font-sans text-amber-300/80 m-0 mt-1 line-clamp-1">
          <span class="text-amber-400 font-semibold">Reading:</span> {currentlyReading.title}
        </p>
      )}
    </div>
  </div>
</Card>
